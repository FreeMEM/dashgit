import "ordenes.dash"

var contexto: Int = 3      # las líneas iguales alrededor de cada trozo (-U)
const MAX_CELDAS = 400000   # tope de la tabla del LCS (2 bytes cada celda)

# Las líneas de un blob ("" de id: ninguna); nil si es binario
func lineas_de(id: String) -> [String]
    var r: [String] = []
    if id == ""
        return r
    end
    o = objeto_leer(id)
    if o == nil
        return r
    end
    r = _partir(o.datos, o.n)
    objeto_libre(o)
    return r
end

func lineas_de_fichero(ruta: String) -> [String]
    var r: [String] = []
    t = leer_fichero(ruta_amiga(ruta))
    if t == nil
        return r
    end
    r = _partir(t.buf, t.n)
    trozo_libre(t)
    return r
end

func _partir(b: Pointer, n: Int) -> [String]
    mira = n
    if mira > 8000
        mira = 8000
    end
    if mira > 0 and buffer_find_byte(b, 0, mira, 0) >= 0
        return nil
    end
    var r: [String] = []
    i = 0
    while i < n
        nl = buffer_find_byte(b, i, n, 10)
        if nl < 0
            r.push(str_from_buffer(b, i, n - i) + "\n\\ No newline at end of file")
            return r
        end
        r.push(str_from_buffer(b, i, nl - i))
        i = nl + 1
    end
    return r
end

# Las operaciones de pasar de a a b: " " igual, "-" quitar, "+" poner, una por línea (en orden)
func operaciones(a: [String], b: [String]) -> [String]
    var ops: [String] = []
    n = a.length
    m = b.length
    ini = 0
    while ini < n and ini < m and a[ini] == b[ini]
        ini = ini + 1
    end
    fa = n
    fb = m
    while fa > ini and fb > ini and a[fa - 1] == b[fb - 1]
        fa = fa - 1
        fb = fb - 1
    end
    i = 0
    while i < ini
        ops.push(" ")
        i = i + 1
    end
    x = fa - ini
    y = fb - ini
    # la tabla del LCS solo si cabe (sin multiplicar: con muchas líneas, (x + 1) * (y + 1) se sale de 32 bits)
    var t: Pointer = nil
    w = y + 1
    if x > 0 and y > 0 and x + 1 <= MAX_CELDAS / (y + 1)
        t = buffer_alloc((x + 1) * w * 2)
    end
    if t != nil
        # LCS: t[i][j] = lo más largo común de a[ini+i..fa) y b[ini+j..fb)
        buffer_fill(t, 0, (x + 1) * w * 2, 0)
        i = x - 1
        while i >= 0
            j = y - 1
            while j >= 0
                if a[ini + i] == b[ini + j]
                    buffer_set_word(t, (i * w + j) * 2, buffer_get_word(t, ((i + 1) * w + j + 1) * 2) + 1)
                else
                    p = buffer_get_word(t, ((i + 1) * w + j) * 2)
                    q = buffer_get_word(t, (i * w + j + 1) * 2)
                    if q > p
                        p = q
                    end
                    buffer_set_word(t, (i * w + j) * 2, p)
                end
                j = j - 1
            end
            i = i - 1
        end
        i = 0
        j = 0
        while i < x and j < y
            if a[ini + i] == b[ini + j]
                ops.push(" ")
                i = i + 1
                j = j + 1
            elif buffer_get_word(t, ((i + 1) * w + j) * 2) >= buffer_get_word(t, (i * w + j + 1) * 2)
                ops.push("-")
                i = i + 1
            else
                ops.push("+")
                j = j + 1
            end
        end
        while i < x
            ops.push("-")
            i = i + 1
        end
        while j < y
            ops.push("+")
            j = j + 1
        end
        buffer_free(t)
    else
        i = 0
        while i < x
            ops.push("-")
            i = i + 1
        end
        i = 0
        while i < y
            ops.push("+")
            i = i + 1
        end
    end
    i = fa
    while i < n
        ops.push(" ")
        i = i + 1
    end
    return ops
end

func _rango(desde: Int, cuantas: Int) -> String
    if cuantas == 1
        return str_from_int(desde, 10)
    end
    if cuantas == 0
        return str_from_int(desde - 1, 10) + ",0"
    end
    return str_from_int(desde, 10) + "," + str_from_int(cuantas, 10)
end

# Escribe los trozos del diff de a a b
func escribir_trozos(a: [String], b: [String])
    var ops: [String] = operaciones(a, b)
    total = ops.length
    k = 0
    while k < total
        # el siguiente cambio
        while k < total and ops[k] == " "
            k = k + 1
        end
        if k >= total
            return
        end
        # el trozo empieza contexto antes y acaba cuando hay más de 2*contexto iguales seguidas
        ini = k - contexto
        if ini < 0
            ini = 0
        end
        fin = k
        iguales = 0
        while fin < total
            if ops[fin] == " "
                iguales = iguales + 1
                if iguales > 2 * contexto
                    fin = fin + 1
                    break
                end
            else
                iguales = 0
            end
            fin = fin + 1
        end
        fin = fin - iguales + contexto
        if fin > total
            fin = total
        end
        # dónde empieza en a y en b
        ia = 0
        ib = 0
        z = 0
        while z < ini
            if ops[z] != "+"
                ia = ia + 1
            end
            if ops[z] != "-"
                ib = ib + 1
            end
            z = z + 1
        end
        ca = 0
        cb = 0
        z = ini
        while z < fin
            if ops[z] != "+"
                ca = ca + 1
            end
            if ops[z] != "-"
                cb = cb + 1
            end
            z = z + 1
        end
        Print "@@ -" + _rango(ia + 1, ca) + " +" + _rango(ib + 1, cb) + " @@"
        z = ini
        while z < fin
            if ops[z] == " "
                Print " " + a[ia]
                ia = ia + 1
                ib = ib + 1
            elif ops[z] == "-"
                Print "-" + a[ia]
                ia = ia + 1
            else
                Print "+" + b[ib]
                ib = ib + 1
            end
            z = z + 1
        end
        k = fin
    end
end

# El diff de un fichero: ids "" para "no está"; con en_trabajo, b se lee del disco
func diff_fichero(ruta: String, id_a: String, modo_a: Int, id_b: String, modo_b: Int, en_trabajo: Bool)
    nombre = utf8_to_latin1(ruta)
    Print "diff --git a/" + nombre + " b/" + nombre
    var a: [String] = lineas_de(id_a)
    var b: [String] = []
    if en_trabajo
        b = lineas_de_fichero(ruta)
    else
        b = lineas_de(id_b)
    end
    cero = "0000000"
    ca = cero
    if id_a != ""
        ca = id_a[:7]
    end
    cb = cero
    if id_b != ""
        cb = id_b[:7]
    end
    if id_a == ""
        Print "new file mode " + modo_texto(modo_b)
        Print "index " + ca + ".." + cb
    elif id_b == "" and not en_trabajo
        Print "deleted file mode " + modo_texto(modo_a)
        Print "index " + ca + ".." + cb
    else
        Print "index " + ca + ".." + cb + " " + modo_texto(modo_a)
    end
    if a == nil or b == nil
        Print "Binary files differ"
        return
    end
    if id_a == ""
        Print "--- /dev/null"
    else
        Print "--- a/" + nombre
    end
    if id_b == "" and not en_trabajo
        Print "+++ /dev/null"
    else
        Print "+++ b/" + nombre
    end
    escribir_trozos(a, b)
end

# Cómo sale cada fichero que cambia: el parche, solo su nombre, su letra (A, M, D) y nombre, cuántas líneas se
# añaden y se quitan, o los rangos de líneas cambiadas (para el margen de un editor, ver diff_rangos)
const D_PARCHE = 0
const D_NOMBRES = 1
const D_LETRAS = 2
const D_CUENTAS = 3
const D_RANGOS = 4
var diff_modo: Int = 0

# Las líneas de los dos lados de un fichero (nil si es binario)
var _la: [String] = []
var _lb: [String] = []

func _lados(ruta: String, id_a: String, id_b: String, en_trabajo: Bool)
    _la = lineas_de(id_a)
    if en_trabajo
        _lb = lineas_de_fichero(ruta)
    else
        _lb = lineas_de(id_b)
    end
end

# Un fichero que cambia, como pide diff_modo
func cambio_fichero(ruta: String, id_a: String, modo_a: Int, id_b: String, modo_b: Int, en_trabajo: Bool)
    nombre = utf8_to_latin1(ruta)
    if diff_modo == D_PARCHE
        diff_fichero(ruta, id_a, modo_a, id_b, modo_b, en_trabajo)
    elif diff_modo == D_NOMBRES
        Print nombre
    elif diff_modo == D_LETRAS
        letra = "M"
        if id_a == ""
            letra = "A"
        elif id_b == "" and not en_trabajo
            letra = "D"
        end
        Print letra + "\t" + nombre
    elif diff_modo == D_CUENTAS
        _lados(ruta, id_a, id_b, en_trabajo)
        if _la == nil or _lb == nil
            Print "-\t-\t" + nombre
        else
            mas = 0
            menos = 0
            for op in operaciones(_la, _lb)
                if op == "+"
                    mas = mas + 1
                elif op == "-"
                    menos = menos + 1
                end
            end
            Print str_from_int(mas, 10) + "\t" + str_from_int(menos, 10) + "\t" + nombre
        end
    else
        diff_rangos(ruta, id_a, id_b, en_trabajo)
    end
end

# --rangos: "F ruta" y una línea por cada trozo que cambia, con la línea del lado nuevo donde empieza (desde 1) y
# cuántas son: "A n c" añadidas, "C n c" cambiadas, "B n c" c líneas quitadas justo antes de la n (n puede ser la
# última + 1). Un trozo con q quitadas y p puestas da min(q, p) cambiadas y el resto añadidas o quitadas.
# Un fichero binario da "F ruta" y "X".
func diff_rangos(ruta: String, id_a: String, id_b: String, en_trabajo: Bool)
    _lados(ruta, id_a, id_b, en_trabajo)
    Print "F " + utf8_to_latin1(ruta)
    if _la == nil or _lb == nil
        Print "X"
        return
    end
    var ops: [String] = operaciones(_la, _lb)
    total = ops.length
    linea = 1     # la línea del lado nuevo por la que va
    k = 0
    while k < total
        if ops[k] == " "
            linea = linea + 1
            k = k + 1
            continue
        end
        quitadas = 0
        puestas = 0
        while k < total and ops[k] != " "
            if ops[k] == "-"
                quitadas = quitadas + 1
            else
                puestas = puestas + 1
            end
            k = k + 1
        end
        cambiadas = quitadas
        if puestas < cambiadas
            cambiadas = puestas
        end
        if cambiadas > 0
            Print "C " + str_from_int(linea, 10) + " " + str_from_int(cambiadas, 10)
        end
        if puestas > cambiadas
            Print "A " + str_from_int(linea + cambiadas, 10) + " " + str_from_int(puestas - cambiadas, 10)
        elif quitadas > cambiadas
            Print "B " + str_from_int(linea + cambiadas, 10) + " " + str_from_int(quitadas - cambiadas, 10)
        end
        linea = linea + puestas
    end
end

# El id de lo que hay en el disco de un fichero del índice; "" si no está
func id_en_trabajo(e: EntradaIndice) -> String
    f = trabajo_mirar(e.ruta)
    if f.tam < 0
        return ""
    end
    if f.tam == e.tam and f.mtime == e.mtime
        return e.id
    end
    return trabajo_guardar(e.ruta, false)
end

# Compara dos listas de ficheros (de un commit o del índice) y saca cada uno que cambia. Con b_trabajo, el lado b
# es lo que hay en el disco de los ficheros de la lista b (los que siguen el índice).
func diff_listas(a: [EntradaIndice], b: [EntradaIndice], b_trabajo: Bool, filtro: [String])
    var en_a: {String: Int} = {}
    var en_b: {String: Int} = {}
    var rutas: [String] = []
    i = 0
    while i < a.length
        if a[i].etapa == 0
            en_a[a[i].ruta] = i + 1
            rutas.push(a[i].ruta)
        end
        i = i + 1
    end
    i = 0
    while i < b.length
        if b[i].etapa == 0
            en_b[b[i].ruta] = i + 1
            if en_a.get(b[i].ruta, 0) == 0
                rutas.push(b[i].ruta)
            end
        end
        i = i + 1
    end
    rutas.sort(texto_antes)
    for r in rutas
        if _pasa(r, filtro)
            p = en_a.get(r, 0)
            q = en_b.get(r, 0)
            id_a = ""
            modo_a = 0
            if p > 0
                id_a = a[p - 1].id
                modo_a = a[p - 1].modo
            end
            id_b = ""
            modo_b = 0
            if q > 0
                modo_b = b[q - 1].modo
                if b_trabajo
                    id_b = id_en_trabajo(b[q - 1])
                else
                    id_b = b[q - 1].id
                end
            end
            if id_a != id_b and (id_a != "" or id_b != "")
                cambio_fichero(r, id_a, modo_a, id_b, modo_b, b_trabajo and id_b != "")
            end
        end
    end
end

# Las opciones de salida de diff y show; true si a era una
func opcion_diff(a: String) -> Bool
    if a == "--name-only"
        diff_modo = D_NOMBRES
    elif a == "--name-status"
        diff_modo = D_LETRAS
    elif a == "--numstat"
        diff_modo = D_CUENTAS
    elif a == "--rangos"
        diff_modo = D_RANGOS
    elif a == "-p" or a == "--patch"
        diff_modo = D_PARCHE
    elif str_starts(a, "--unified=")
        contexto = str_to_int(a[10:], 10)
    elif str_starts(a, "-U") and a.length > 2
        contexto = str_to_int(a[2:], 10)
    else
        return false
    end
    if contexto < 0
        contexto = 0
    end
    return true
end

# diff [--cached] [commit [commit]] [opciones] [--] [ruta...]
#   sin commits: el índice contra el disco; --cached: HEAD (o el commit) contra el índice; un commit: el commit
#   contra el disco; dos (o a..b): el uno contra el otro. Opciones: --name-only, --name-status, --numstat, --rangos,
#   -U n (--unified=n).
func orden_diff(args: [String])
    preparado = false
    var revs: [String] = []
    var filtro: [String] = []
    rutas_ya = false
    for x in args
        if rutas_ya
            filtro.push(ruta_git(x))
        elif x == "--"
            rutas_ya = true
        elif x == "--cached" or x == "--staged"
            preparado = true
        elif opcion_diff(x)
            # hecho
        elif str_starts(x, "-")
            aviso("opción desconocida de diff: " + x)
            return
        elif revs.length == 0 and str_contains(x, "..") and filtro.length == 0
            p = str_find(x, "..")
            ia = x[:p]
            ib = x[p + 2:]
            if ia == ""
                ia = "HEAD"
            end
            if ib == ""
                ib = "HEAD"
            end
            revs.push(ia)
            revs.push(ib)
        elif revs.length < 2 and filtro.length == 0 and (rev_commit(x) != "" or x == "HEAD")
            revs.push(x)
        else
            filtro.push(ruta_git(x))
        end
    end
    var ids: [String] = []
    for r in revs
        id = rev_commit(r)
        if id == "" and r == "HEAD" and head_id() == ""
            # sin commits aún, HEAD es el árbol vacío (como el de git: todo sale como nuevo)
            ids.push("")
            continue
        end
        if id == ""
            aviso("no existe " + r)
            return
        end
        ids.push(id)
    end
    if ids.length == 2
        var c1: [EntradaIndice] = ficheros_de_commit(ids[0])
        var c2: [EntradaIndice] = ficheros_de_commit(ids[1])
        if c1 == nil or c2 == nil
            aviso("falta algún objeto")
            return
        end
        diff_listas(c1, c2, false, filtro)
        return
    end
    var idx: [EntradaIndice] = indice_leer()
    if idx == nil
        aviso(indice_error)
        return
    end
    if preparado or ids.length == 1
        base = head_id()
        if ids.length == 1
            base = ids[0]
        end
        var cab: [EntradaIndice] = ficheros_de_commit(base)
        if cab == nil
            aviso("falta algún objeto del commit " + base)
            return
        end
        diff_listas(cab, idx, not preparado, filtro)
        return
    end
    # el índice contra el árbol de trabajo
    diff_listas(idx, idx, true, filtro)
end

# show [opciones] [commit] [--] [ruta...]: el commit (como log) y sus cambios frente a su primer padre (una fusión
# sale sin cambios); show commit:ruta: el contenido de ese fichero en ese commit (la ruta, desde la raíz)
func orden_show(args: [String])
    log_corto = false
    log_con_formato = false
    diff_modo = D_PARCHE
    que = ""
    var filtro: [String] = []
    rutas_ya = false
    sin_cambios = false
    for x in args
        if rutas_ya
            filtro.push(ruta_git(x))
        elif x == "--"
            rutas_ya = true
        elif opcion_formato(x) or opcion_diff(x)
            # hecho
        elif x == "-s" or x == "--no-patch"
            sin_cambios = true
        elif str_starts(x, "-")
            aviso("opción desconocida de show: " + x)
            return
        elif que == ""
            que = x
        else
            filtro.push(ruta_git(x))
        end
    end
    if que == ""
        que = "HEAD"
    end
    dos = str_find(que, ":")
    # (un nombre con ":" de unidad del Amiga, "DH0:x", no es un commit: se mira que lo de antes sea un commit)
    if dos > 0 and rev_commit(que[:dos]) != ""
        id = rev_commit(que[:dos])
        ruta = latin1_to_utf8(que[dos + 1:])
        while str_starts(ruta, "/")
            ruta = ruta[1:]
        end
        obj = id_en_arbol(commit_arbol(id), ruta)
        if obj == ""
            aviso(que[dos + 1:] + " no está en " + que[:dos])
            return
        end
        o = objeto_leer(obj)
        if o == nil
            aviso("no se puede leer el objeto " + obj)
            return
        end
        if o.tipo == "tree"
            for e in arbol_leer(o)
                n = utf8_to_latin1(e.nombre)
                if e.modo == "40000"
                    n = n + "/"
                end
                Print n
            end
        elif o.n > 0
            console_write(str_from_buffer(o.datos, 0, o.n))
        end
        objeto_libre(o)
        return
    end
    id = rev_commit(que)
    if id == ""
        aviso("no existe " + que)
        return
    end
    o = objeto_leer(id)
    if o == nil
        aviso("no se puede leer el commit " + id)
        return
    end
    escribir_commit(id, o)
    var ps: [String] = commit_padres(o)
    objeto_libre(o)
    if sin_cambios or ps.length > 1
        return
    end
    if log_con_formato and log_formato != ""
        Print ""
    end
    var antes: [EntradaIndice] = []
    if ps.length == 1
        antes = ficheros_de_commit(ps[0])
    end
    var ahora: [EntradaIndice] = ficheros_de_commit(id)
    if antes == nil or ahora == nil
        aviso("falta algún objeto")
        return
    end
    diff_listas(antes, ahora, false, filtro)
end

func _pasa(r: String, filtro: [String]) -> Bool
    if filtro.length == 0
        return true
    end
    for c in filtro
        if dentro_de(r, c)
            return true
        end
    end
    return false
end
