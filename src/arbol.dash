import "indice.dash"

# ---- del índice a árboles ----

struct _Hijo
    nombre: String = ""
    modo: String = ""
    id: String = ""
    clave: String = ""    # el nombre, con "/" detrás si es un cajón (el orden de git)
end

func _por_clave(a: _Hijo, b: _Hijo) -> Bool
    return a.clave < b.clave
end

# Guarda los árboles de las entradas l[desde..hasta) que empiezan por prefijo; el id del de arriba ("" si falló)
func _arbol_de(l: [EntradaIndice], desde: Int, hasta: Int, prefijo: String) -> String
    var hijos: [_Hijo] = []
    i = desde
    while i < hasta
        resto = l[i].ruta[prefijo.length:]
        barra = str_find(resto, "/")
        if barra < 0
            h = _Hijo()
            h.nombre = resto
            h.clave = resto
            h.modo = modo_texto(l[i].modo)
            h.id = l[i].id
            hijos.push(h)
            i = i + 1
        else
            cajon = resto[:barra]
            pre = prefijo + cajon + "/"
            j = i
            while j < hasta and str_starts(l[j].ruta, pre)
                j = j + 1
            end
            id = _arbol_de(l, i, j, pre)
            if id == ""
                return ""
            end
            h = _Hijo()
            h.nombre = cajon
            h.clave = cajon + "/"
            h.modo = "40000"
            h.id = id
            hijos.push(h)
            i = j
        end
    end
    hijos.sort(_por_clave)
    total = 0
    for h in hijos
        total = total + h.modo.length + 1 + h.nombre.length + 1 + 20
    end
    b = buffer_alloc(total + 1)
    o = 0
    for h in hijos
        str_to_buffer(h.modo + " " + h.nombre, b, o)
        o = o + h.modo.length + 1 + h.nombre.length
        buffer_set_byte(b, o, 0)
        de_hex(h.id, b, o + 1)
        o = o + 21
    end
    id = objeto_escribir("tree", b, total, true)
    buffer_free(b)
    return id
end

# Guarda los árboles del índice; el id del de la raíz
func arbol_del_indice(l: [EntradaIndice]) -> String
    l.sort(por_ruta)
    return _arbol_de(l, 0, l.length, "")
end

# ---- de un árbol a la lista de sus ficheros ----

# Añade a r los ficheros del árbol id, con las rutas detrás de prefijo; false si falta algún objeto
func arbol_aplanar(id: String, prefijo: String, r: [EntradaIndice]) -> Bool
    o = objeto_leer(id)
    if o == nil or o.tipo != "tree"
        objeto_libre(o)
        return false
    end
    var es: [Entrada] = arbol_leer(o)
    objeto_libre(o)
    for e in es
        if e.modo == "40000"
            if not arbol_aplanar(e.id, prefijo + e.nombre + "/", r)
                return false
            end
        else
            x = EntradaIndice()
            x.ruta = prefijo + e.nombre
            x.id = e.id
            x.modo = modo_numero(e.modo)
            r.push(x)
        end
    end
    return true
end

# Los ficheros de un commit (lista vacía si id es ""); nil si falta algo
func ficheros_de_commit(id: String) -> [EntradaIndice]
    var r: [EntradaIndice] = []
    if id == ""
        return r
    end
    c = objeto_leer(id)
    if c == nil or c.tipo != "commit"
        objeto_libre(c)
        return nil
    end
    arbol = commit_campo(c, "tree")
    objeto_libre(c)
    if not arbol_aplanar(arbol, "", r)
        return nil
    end
    r.sort(por_ruta)
    return r
end

func commit_arbol(id: String) -> String
    c = objeto_leer(id)
    if c == nil
        return ""
    end
    a = commit_campo(c, "tree")
    objeto_libre(c)
    return a
end

# ---- fechas ----

# La zona horaria ("+0100"): la de dashgit.zona si está, si no la de las Preferencias de Locale
func zona() -> String
    z = config_leer("dashgit.zona")
    if z.length == 5 and (str_starts(z, "+") or str_starts(z, "-"))
        return z
    end
    m = locale_gmt_offset()
    signo = "+"
    if m < 0
        signo = "-"
        m = -m
    end
    return signo + _dos(m / 60) + _dos(m % 60)
end

# Los segundos de una zona ("+0130" da 5400)
func zona_segundos(z: String) -> Int
    if z.length != 5
        return 0
    end
    s = Int(z[1:3]) * 3600 + Int(z[3:5]) * 60
    if str_starts(z, "-")
        return -s
    end
    return s
end

func _dos(n: Int) -> String
    if n < 10
        return "0" + str_from_int(n, 10)
    end
    return str_from_int(n, 10)
end

# "2026-11-04 12:30:05 +0100" de segundos UTC y una zona
func fecha_texto(t: Int, z: String) -> String
    s = t + zona_segundos(z)
    dias = s / 86400
    resto = s - dias * 86400
    if resto < 0
        resto = resto + 86400
        dias = dias - 1
    end
    # días desde 1970 a año, mes y día (algoritmo de Howard Hinnant)
    x = dias + 719468
    era = x / 146097
    doe = x - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    a = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    d = doy - (153 * mp + 2) / 5 + 1
    m = mp + 3
    if mp >= 10
        m = mp - 9
    end
    if m <= 2
        a = a + 1
    end
    return str_from_int(a, 10) + "-" + _dos(m) + "-" + _dos(d) + " " + _dos(resto / 3600) + ":" + _dos((resto / 60) % 60) + ":" + _dos(resto % 60) + " " + z
end

# La firma de ahora: "Nombre <correo> 1730720000 +0100"; "" si falta user.name o user.email
func firma_ahora() -> String
    n = config_leer("user.name")
    e = config_leer("user.email")
    if n == "" or e == ""
        return ""
    end
    z = zona()
    t = time_unix() - zona_segundos(z)
    return n + " <" + e + "> " + str_from_int(t, 10) + " " + z
end

# "Nombre <correo>" y la fecha de una firma de commit
func firma_quien(f: String) -> String
    i = str_find(f, ">")
    if i < 0
        return f
    end
    return f[:i + 1]
end

func firma_fecha(f: String) -> String
    i = str_find(f, ">")
    if i < 0
        return ""
    end
    p = str_split(str_trim(f[i + 1:]), " ")
    if p.length < 2
        return ""
    end
    return fecha_texto(Int(p[0]), p[1])
end

# El mensaje de un commit (lo que va tras la línea en blanco)
func commit_mensaje(o: Objeto) -> String
    i = 0
    while i < o.n - 1
        if buffer_get_byte(o.datos, i) == 10 and buffer_get_byte(o.datos, i + 1) == 10
            return str_from_buffer(o.datos, i + 2, o.n - i - 2)
        end
        i = i + 1
    end
    return ""
end

# Los padres de un commit
func commit_padres(o: Objeto) -> [String]
    var r: [String] = []
    i = 0
    while i < o.n
        nl = buffer_find_byte(o.datos, i, o.n, 10)
        if nl < 0 or nl == i
            break
        end
        linea = str_from_buffer(o.datos, i, nl - i)
        if str_starts(linea, "parent ")
            r.push(linea[7:])
        end
        i = nl + 1
    end
    return r
end

# Guarda un commit; su id ("" si falló)
func commit_crear(arbol: String, padres: [String], firma: String, mensaje: String) -> String
    t = "tree " + arbol + "\n"
    for p in padres
        t = t + "parent " + p + "\n"
    end
    m = mensaje
    if not str_ends(m, "\n")
        m = m + "\n"
    end
    t = t + "author " + firma + "\ncommitter " + firma + "\n\n" + m
    return objeto_escribir_texto("commit", t)
end
