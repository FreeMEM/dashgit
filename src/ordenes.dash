import "arbol.dash"

func aviso(msg: String)
    codigo = 10
    sal("dashgit: " + msg)
end

# ---- rutas que escribe el usuario ----

# El cajón actual relativo a la raíz, en ruta de git ("" en la raíz)
func cajon_actual() -> String
    d = dir_current()
    if str_lower(d) == str_lower(raiz)
        return ""
    end
    pre = raiz
    if not str_ends(pre, ":") and not str_ends(pre, "/")
        pre = pre + "/"
    end
    if str_starts(str_lower(d), str_lower(pre))
        return latin1_to_utf8(d[pre.length:])
    end
    return ""
end

# Lo que escribe el usuario ("fichero", "sub/f", ".", "DH0:repo/x") a una ruta de git; "?" si queda fuera
func ruta_git(a: String) -> String
    if str_contains(a, ":")
        pre = raiz
        if not str_ends(pre, ":") and not str_ends(pre, "/")
            pre = pre + "/"
        end
        if str_lower(a) == str_lower(raiz)
            return ""
        end
        if not str_starts(str_lower(a), str_lower(pre))
            return "?"
        end
        return latin1_to_utf8(a[pre.length:])
    end
    base = cajon_actual()
    r = latin1_to_utf8(a)
    while str_starts(r, "./")
        r = r[2:]
    end
    if r == "." or r == ""
        return base
    end
    if str_ends(r, "/")
        r = r[:r.length - 1]
    end
    if base == ""
        return r
    end
    return base + "/" + r
end

# Si ruta está en el cajón c o es c ("" es todo)
func dentro_de(ruta: String, c: String) -> Bool
    return c == "" or ruta == c or str_starts(ruta, c + "/")
end

# ---- add ----

func orden_add(args: [String])
    if args.length == 0
        aviso("no se añadió nada (prueba con dashgit add .)")
        return
    end
    var idx: [EntradaIndice] = indice_leer()
    if idx == nil
        aviso(indice_error)
        return
    end
    var todos: [FicheroTrabajo] = trabajo_listar("")
    var cajones: [String] = []
    for a in args
        if a == "-A" or a == "--all"
            cajones.push("")
        elif a == "--"
            # (como git: lo que sigue son rutas)
        else
            r = ruta_git(a)
            if r == "?"
                aviso(a + " está fuera del repositorio")
                return
            end
            cajones.push(r)
        end
    end
    cambios = 0
    for c in cajones
        hallado = false
        # ficheros nuevos o cambiados
        for f in todos
            if dentro_de(f.ruta, c)
                hallado = true
                # si tenía conflicto (etapas 1-3), se da por resuelto
                q = idx.length - 1
                while q >= 0
                    if idx[q].ruta == f.ruta and idx[q].etapa > 0
                        idx.remove(q)
                        cambios = cambios + 1
                    end
                    q = q - 1
                end
                p = indice_buscar(idx, f.ruta)
                if p >= 0 or not ignorada(f.ruta) or f.ruta == c
                    if p >= 0 and idx[p].tam == f.tam and idx[p].mtime == f.mtime
                        # sin cambios
                    else
                        id = trabajo_guardar(f.ruta, true)
                        if id == ""
                            aviso("no se puede leer " + utf8_to_latin1(f.ruta))
                            return
                        end
                        if p < 0
                            # lo que choque con esta ruta sale del índice: un fichero "a" si se añade "a/x", o lo
                            # de dentro de "a/" si se añade el fichero "a" (como git)
                            q = idx.length - 1
                            while q >= 0
                                if str_starts(f.ruta, idx[q].ruta + "/") or str_starts(idx[q].ruta, f.ruta + "/")
                                    idx.remove(q)
                                end
                                q = q - 1
                            end
                            e = EntradaIndice()
                            e.ruta = f.ruta
                            idx.push(e)
                            p = idx.length - 1
                            cambios = cambios + 1
                        elif idx[p].id != id
                            cambios = cambios + 1
                        end
                        idx[p].id = id
                        idx[p].tam = f.tam
                        idx[p].mtime = f.mtime
                        idx[p].ctime = f.mtime
                        idx[p].mtime_ns = 0
                        idx[p].ctime_ns = 0
                    end
                end
            end
        end
        # borrados del árbol de trabajo (lo que no puede estar en este disco no cuenta)
        var fuera: {String: String} = fuera_del_disco(idx)
        i = idx.length - 1
        while i >= 0
            if dentro_de(idx[i].ruta, c) and fuera.get(idx[i].ruta, "") == ""
                hallado = true
                esta = false
                for f in todos
                    if f.ruta == idx[i].ruta
                        esta = true
                        break
                    end
                end
                if not esta
                    idx.remove(i)
                    cambios = cambios + 1
                end
            end
            i = i - 1
        end
        if not hallado
            aviso("ningún fichero encaja con " + utf8_to_latin1(c))
        end
    end
    if not indice_escribir(idx)
        aviso("no se pudo escribir el índice")
    end
end

# ---- rm ----

func orden_rm(args: [String])
    solo_indice = false
    recursivo = false
    forzar = false
    var rutas: [String] = []
    var escritas: [String] = []
    for a in args
        if a == "--cached"
            solo_indice = true
        elif a == "-r"
            recursivo = true
        elif a == "-f" or a == "--force"
            forzar = true
        elif a == "-rf" or a == "-fr"
            recursivo = true
            forzar = true
        elif a != "--"
            rutas.push(ruta_git(a))
            escritas.push(a)
        end
    end
    if rutas.length == 0
        aviso("uso: rm [-r] [-f] [--cached] fichero...")
        return
    end
    var idx: [EntradaIndice] = indice_leer()
    if idx == nil
        aviso(indice_error)
        return
    end
    # primero se mira todo; si algo no se puede, no se borra nada (como git)
    var quitar: {String: Int} = {}
    k = 0
    while k < rutas.length
        r = rutas[k]
        hallado = false
        for e in idx
            if dentro_de(e.ruta, r)
                hallado = true
                if e.ruta != r and not recursivo
                    aviso("no se borra '" + escritas[k] + "' sin -r (es un cajón)")
                    return
                end
                quitar[e.ruta] = 1
            end
        end
        if not hallado
            aviso("'" + escritas[k] + "' no encaja con ningún fichero del índice; no se ha borrado nada")
            return
        end
        k = k + 1
    end
    if not forzar
        var cab: [EntradaIndice] = ficheros_de_commit(head_id())
        var en_cab: {String: String} = {}
        if cab != nil
            for e in cab
                en_cab[e.ruta] = e.id
            end
        end
        var mal: [String] = []
        for e in idx
            if quitar.get(e.ruta, 0) == 1 and e.etapa == 0
                preparado = en_cab.get(e.ruta, "") != e.id
                cambiado = false
                f = trabajo_mirar(e.ruta)
                if f.tam >= 0 and (f.tam != e.tam or f.mtime != e.mtime)
                    cambiado = trabajo_guardar(e.ruta, false) != e.id
                end
                if solo_indice
                    if preparado and cambiado
                        mal.push(e.ruta + " (cambios añadidos y otros sin añadir)")
                    end
                elif preparado
                    mal.push(e.ruta + " (cambios añadidos sin commit)")
                elif cambiado
                    mal.push(e.ruta + " (cambios sin commit)")
                end
            end
        end
        if mal.length > 0
            aviso("no se ha borrado nada; estos ficheros tienen cambios que se perderían:")
            for m in mal
                sal("        " + utf8_to_latin1(m))
            end
            sal("Haz commit de ellos, o usa --cached para dejarlos en el disco, o -f para borrarlos igualmente.")
            return
        end
    end
    # ahora sí
    var queda: [EntradaIndice] = []
    var borradas: [String] = []
    for e in idx
        if quitar.get(e.ruta, 0) == 1
            if borradas.length == 0 or borradas[borradas.length - 1] != e.ruta
                borradas.push(e.ruta)
            end
        else
            queda.push(e)
        end
    end
    for r in borradas
        sal("rm '" + utf8_to_latin1(r) + "'")
        if not solo_indice
            ruta = ruta_amiga(r)
            if file_exists(ruta) and not file_delete(ruta)
                aviso("no se pudo borrar " + ruta + " del disco (¿protegido contra borrado?)")
            end
            _quitar_cajones_vacios(ruta_padre(ruta))
        end
    end
    indice_escribir(queda)
end

# ---- status ----

struct Estado
    conflictos: [String] = []    # "sin fusionar: x" (corto: "UU x")
    preparados: [String] = []    # "nuevo: x", "cambiado: x", "borrado: x" (corto: "A  x"...)
    sin_preparar: [String] = []
    nuevos: [String] = []
end

# Compara HEAD, el índice y el árbol de trabajo. corto: las líneas como git status -s.
func estado(corto: Bool) -> Estado
    r = Estado()
    var todo_idx: [EntradaIndice] = indice_leer()
    if todo_idx == nil
        aviso(indice_error)
        return nil
    end
    var cab: [EntradaIndice] = ficheros_de_commit(head_id())
    if cab == nil
        aviso("falta algún objeto del commit de HEAD")
        return nil
    end
    # los ficheros con conflicto aparte; el resto, solo la etapa 0
    var en_conflicto: {String: Int} = {}
    var idx: [EntradaIndice] = []
    for e in todo_idx
        if e.etapa > 0
            if en_conflicto.get(e.ruta, 0) == 0
                en_conflicto[e.ruta] = 1
                r.conflictos.push(_linea(corto, "UU", "sin fusionar: ", e.ruta))
            end
        else
            idx.push(e)
        end
    end
    # HEAD contra el índice
    var en_cab: {String: Int} = {}
    i = 0
    while i < cab.length
        en_cab[cab[i].ruta] = i + 1
        i = i + 1
    end
    for e in idx
        p = en_cab.get(e.ruta, 0)
        if p == 0
            r.preparados.push(_linea(corto, "A ", "nuevo:      ", e.ruta))
        elif cab[p - 1].id != e.id or cab[p - 1].modo != e.modo
            r.preparados.push(_linea(corto, "M ", "cambiado:   ", e.ruta))
        end
    end
    var en_idx: {String: Int} = {}
    i = 0
    while i < idx.length
        en_idx[idx[i].ruta] = i + 1
        i = i + 1
    end
    for e in cab
        if en_idx.get(e.ruta, 0) == 0 and en_conflicto.get(e.ruta, 0) == 0
            r.preparados.push(_linea(corto, "D ", "borrado:    ", e.ruta))
        end
    end
    # el índice contra el árbol de trabajo
    var todos: [FicheroTrabajo] = trabajo_listar("")
    var en_trabajo: {String: Int} = {}
    i = 0
    while i < todos.length
        en_trabajo[todos[i].ruta] = i + 1
        i = i + 1
    end
    refrescar = false
    # lo que no puede estar en este disco no se da por borrado
    var fuera: {String: String} = fuera_del_disco(idx)
    for e in idx
        p = en_trabajo.get(e.ruta, 0)
        if p == 0
            if fuera.get(e.ruta, "") == ""
                r.sin_preparar.push(_linea(corto, " D", "borrado:    ", e.ruta))
            end
        else
            f = todos[p - 1]
            if f.tam != e.tam
                r.sin_preparar.push(_linea(corto, " M", "cambiado:   ", e.ruta))
            elif f.mtime != e.mtime
                if trabajo_guardar(e.ruta, false) != e.id
                    r.sin_preparar.push(_linea(corto, " M", "cambiado:   ", e.ruta))
                else
                    e.mtime = f.mtime
                    e.mtime_ns = 0
                    refrescar = true
                end
            end
        end
    end
    for f in todos
        if en_idx.get(f.ruta, 0) == 0 and en_conflicto.get(f.ruta, 0) == 0 and not ignorada(f.ruta)
            if corto
                r.nuevos.push("?? " + f.ruta)
            else
                r.nuevos.push(f.ruta)
            end
        end
    end
    if refrescar and r.conflictos.length == 0
        indice_escribir(idx)
    end
    return r
end

func _linea(corto: Bool, xy: String, largo: String, ruta: String) -> String
    if corto
        return xy + " " + ruta
    end
    return largo + ruta
end

# Lo que va tras "## " en status -sb, como git: "main", "No commits yet on main", "HEAD (no branch)", y la rama
# del remoto que sigue si está ("main...origin/main")
func linea_de_rama() -> String
    rama = head_rama()
    if rama == ""
        return "HEAD (no branch)"
    end
    nombre = rama[11:]
    if head_id() == ""
        return "No commits yet on " + nombre
    end
    remoto = config_leer("branch." + nombre + ".remote")
    mezcla = config_leer("branch." + nombre + ".merge")
    if remoto != "" and str_starts(mezcla, "refs/heads/")
        sigue = "refs/remotes/" + remoto + "/" + mezcla[11:]
        if ref_leer(sigue) != ""
            return nombre + "..." + sigue[13:]
        end
    end
    return nombre
end

func orden_status(args: [String])
    corto = false
    con_rama = false
    for a in args
        if a == "-s" or a == "--short" or a == "--porcelain" or a == "--porcelain=v1"
            corto = true
        elif a == "-b" or a == "--branch"
            con_rama = true
        elif a == "-sb" or a == "-bs"
            corto = true
            con_rama = true
        end
    end
    e = estado(corto)
    if e == nil
        return
    end
    if corto
        if con_rama
            sal("## " + linea_de_rama())
        end
        # como git: una línea por fichero con las dos letras (índice y árbol de trabajo), por orden de ruta, y los
        # que no se siguen al final
        var xy: {String: String} = {}
        var rutas: [String] = []
        var todas: [String] = []
        for l in e.conflictos
            todas.push(l)
        end
        for l in e.preparados
            todas.push(l)
        end
        for l in e.sin_preparar
            todas.push(l)
        end
        for l in todas
            if true
                r = l[3:]
                antes = xy.get(r, "")
                if antes == ""
                    rutas.push(r)
                    xy[r] = l[:2]
                else
                    x = antes[:1]
                    if x == " "
                        x = l[:1]
                    end
                    y = antes[1:2]
                    if y == " "
                        y = l[1:2]
                    end
                    xy[r] = x + y
                end
            end
        end
        rutas.sort(texto_antes)
        for r in rutas
            sal(utf8_to_latin1(xy[r] + " " + r))
        end
        for l in e.nuevos
            sal(utf8_to_latin1(l))
        end
        return
    end
    rama = head_rama()
    if rama == ""
        sal("HEAD suelto en " + head_id()[:7])
    else
        sal("En la rama " + rama[11:])
    end
    if head_id() == ""
        sal("Aún no hay commits")
    end
    if file_exists(git_dir + "/MERGE_HEAD")
        sal("")
        if e.conflictos.length > 0
            sal("Fusión a medias: arregla los conflictos y haz dashgit add y dashgit commit")
            sal("(o dashgit merge --abort para dejarlo como estaba).")
        else
            sal("Fusión a medias: los conflictos están resueltos; haz dashgit commit para acabarla.")
        end
    end
    if e.conflictos.length > 0
        sal("")
        sal("Sin fusionar:")
        for l in e.conflictos
            sal("        " + utf8_to_latin1(l))
        end
    end
    if e.preparados.length > 0
        sal("")
        sal("Cambios para el commit:")
        for l in e.preparados
            sal("        " + utf8_to_latin1(l))
        end
    end
    if e.sin_preparar.length > 0
        sal("")
        sal("Cambios sin añadir (dashgit add):")
        for l in e.sin_preparar
            sal("        " + utf8_to_latin1(l))
        end
    end
    if e.nuevos.length > 0
        sal("")
        sal("Ficheros sin seguimiento:")
        for l in e.nuevos
            sal("        " + utf8_to_latin1(l))
        end
    end
    if e.conflictos.length == 0 and e.preparados.length == 0 and e.sin_preparar.length == 0 and e.nuevos.length == 0
        sal("No hay nada que confirmar: el árbol de trabajo está limpio")
    end
end

# ---- check-ignore ----

# Escribe las rutas que .gitignore ignora (las demás no); código 1 si no hay ninguna, como git
func orden_check_ignore(args: [String])
    hubo = false
    for a in args
        r = ruta_git(a)
        if r != "?" and r != "" and ignorada(r)
            sal(a)
            hubo = true
        end
    end
    if not hubo and codigo == 0
        codigo = 1
    end
end

# ---- commit ----

func orden_commit(args: [String])
    mensaje = ""
    todo = false
    enmendar = false
    i = 0
    while i < args.length
        if args[i] == "--amend"
            enmendar = true
        elif args[i] == "-m" and i + 1 < args.length
            if mensaje != ""
                mensaje = mensaje + "\n\n"
            end
            mensaje = mensaje + args[i + 1]
            i = i + 1
        elif args[i] == "-a"
            todo = true
        elif args[i] == "-am" and i + 1 < args.length
            todo = true
            mensaje = args[i + 1]
            i = i + 1
        end
        i = i + 1
    end
    fusion = ""
    if file_exists(git_dir + "/MERGE_HEAD")
        fusion = str_trim(file_read_text(git_dir + "/MERGE_HEAD"))[:40]
        if mensaje == "" and file_exists(git_dir + "/MERGE_MSG")
            mensaje = str_trim(file_read_text(git_dir + "/MERGE_MSG"))
        end
        var idc: [EntradaIndice] = indice_leer()
        for e in idc
            if e.etapa > 0
                aviso("quedan conflictos sin resolver (" + utf8_to_latin1(e.ruta) + "): arréglalos y haz dashgit add")
                return
            end
        end
    end
    # --amend: el commit de HEAD se rehace (con sus padres y su autor; el mensaje, el suyo si no se da otro)
    autor = ""
    var padres_viejos: [String] = []
    if enmendar
        if fusion != ""
            aviso("hay una fusión a medias: acábala con dashgit commit antes de --amend")
            return
        end
        h = head_id()
        oh = objeto_leer(h)
        if h == "" or oh == nil
            aviso("no hay commit que enmendar")
            return
        end
        if mensaje == ""
            mensaje = a_latin1(str_trim(commit_mensaje(oh)))
        end
        autor = commit_campo(oh, "author")
        padres_viejos = commit_padres(oh)
        objeto_libre(oh)
    end
    if mensaje == ""
        aviso("falta el mensaje: dashgit commit -m \"mensaje\"")
        return
    end
    firma = firma_ahora()
    if firma == ""
        aviso("dime quién eres:")
        sal("  dashgit config --global user.name \"Tu nombre\"")
        sal("  dashgit config --global user.email tu@correo")
        return
    end
    if todo
        # como add de lo que ya está en el índice
        var idx0: [EntradaIndice] = indice_leer()
        var rutas: [String] = []
        for e in idx0
            rutas.push(e.ruta)
        end
        if not _add_seguidos(idx0)
            return
        end
    end
    var idx: [EntradaIndice] = indice_leer()
    if idx == nil
        aviso(indice_error)
        return
    end
    padre = head_id()
    arbol = arbol_del_indice(idx)
    if arbol == ""
        aviso("no se pudo guardar el árbol")
        return
    end
    var padres: [String] = []
    if enmendar
        padres = padres_viejos
    elif padre != ""
        if fusion == "" and commit_arbol(padre) == arbol
            sal("No hay cambios para el commit (dashgit add para añadirlos)")
            return
        end
        padres.push(padre)
    end
    if fusion != ""
        padres.push(fusion)
    end
    if autor == ""
        autor = a_utf8(firma)
    end
    id = commit_crear_con(arbol, padres, autor, a_utf8(firma), a_utf8(mensaje))
    if id == ""
        aviso("no se pudo guardar el commit")
        return
    end
    rama = head_rama()
    if rama == ""
        file_write_text(git_dir + "/HEAD", id + "\n")
    else
        ref_escribir(rama, id)
    end
    nombre = "HEAD suelto"
    if rama != ""
        nombre = rama[11:]
    end
    raiz_txt = ""
    if enmendar
        raiz_txt = " (enmendado)"
    elif padre == ""
        raiz_txt = " (primer commit)"
    end
    primera = mensaje
    nl = str_find(primera, "\n")
    if nl >= 0
        primera = primera[:nl]
    end
    if fusion != ""
        file_delete(git_dir + "/MERGE_HEAD")
        file_delete(git_dir + "/MERGE_MSG")
    end
    sal("[" + nombre + raiz_txt + " " + id[:7] + "] " + primera)
end

# add de los ficheros que ya sigue el índice (commit -a); false si alguno no se pudo leer
func _add_seguidos(idx: [EntradaIndice]) -> Bool
    var todos: [FicheroTrabajo] = trabajo_listar("")
    var en_trabajo: {String: Int} = {}
    i = 0
    while i < todos.length
        en_trabajo[todos[i].ruta] = i + 1
        i = i + 1
    end
    var fuera: {String: String} = fuera_del_disco(idx)
    i = idx.length - 1
    while i >= 0
        p = en_trabajo.get(idx[i].ruta, 0)
        if p == 0
            if fuera.get(idx[i].ruta, "") == ""
                idx.remove(i)
            end
        else
            f = todos[p - 1]
            if f.tam != idx[i].tam or f.mtime != idx[i].mtime
                id = trabajo_guardar(idx[i].ruta, true)
                if id == ""
                    aviso("no se puede leer " + utf8_to_latin1(idx[i].ruta) + "; no se hace el commit")
                    return false
                end
                idx[i].id = id
                idx[i].tam = f.tam
                idx[i].mtime = f.mtime
                idx[i].mtime_ns = 0
            end
        end
        i = i - 1
    end
    return indice_escribir(idx)
end

# ---- nombres de commits: HEAD~2, main^, HEAD^2, a..b ----

# Un nombre con ~n, ^ o ^n detrás (HEAD~2, main^, HEAD^2) a un commit; "" si no
func rev_commit(nombre: String) -> String
    corte = -1
    i = 0
    while i < nombre.length
        c = nombre[i:i + 1]
        if c == "~" or c == "^"
            corte = i
            break
        end
        i = i + 1
    end
    if corte < 0
        return resolver_commit(nombre)
    end
    id = resolver_commit(nombre[:corte])
    resto = nombre[corte:]
    while resto != "" and id != ""
        op = resto[:1]
        resto = resto[1:]
        if op != "~" and op != "^"
            return ""
        end
        j = 0
        while j < resto.length and str_code(resto, j) >= 48 and str_code(resto, j) <= 57
            j = j + 1
        end
        n = 1
        if j > 0
            n = str_to_int(resto[:j], 10)
            resto = resto[j:]
        end
        if op == "~"
            while n > 0 and id != ""
                var ps: [String] = padres_de(id)
                id = ""
                if ps.length > 0
                    id = ps[0]
                end
                n = n - 1
            end
        elif n > 0
            var ps2: [String] = padres_de(id)
            id = ""
            if n <= ps2.length
                id = ps2[n - 1]
            end
        end
    end
    return id
end

# ---- log ----

# Lo que va en cada placeholder de --format (como git): %H %h %T %t %P %p %an %ae %ad %ai %as %at %cn %ce %cd %ci
# %cs %ct %s %b %B %n %% %xNN. Las fechas %ad y %cd van como %ai ("2026-11-04 12:30:05 +0100").
func formato_commit(f: String, id: String, o: Objeto) -> String
    r = ""
    i = 0
    n = f.length
    while i < n
        c = f[i:i + 1]
        if c != "%" or i + 1 >= n
            r = r + c
            i = i + 1
            continue
        end
        k = f[i + 1:i + 2]
        i = i + 2
        if k == "%"
            r = r + "%"
        elif k == "n"
            r = r + "\n"
        elif k == "H"
            r = r + id
        elif k == "h"
            r = r + id[:7]
        elif k == "T"
            r = r + commit_campo(o, "tree")
        elif k == "t"
            r = r + commit_campo(o, "tree")[:7]
        elif k == "P" or k == "p"
            primero = true
            for pp in commit_padres(o)
                if not primero
                    r = r + " "
                end
                primero = false
                if k == "P"
                    r = r + pp
                else
                    r = r + pp[:7]
                end
            end
        elif k == "s" or k == "b" or k == "B"
            msg = commit_mensaje(o)
            nl = str_find(msg, "\n")
            if k == "s"
                if nl >= 0
                    msg = msg[:nl]
                end
                r = r + msg
            elif k == "b"
                fin = str_find(msg, "\n\n")
                if fin >= 0
                    r = r + str_trim(msg[fin + 2:]) + "\n"
                end
            else
                r = r + msg
            end
        elif (k == "a" or k == "c") and i < n
            q = f[i:i + 1]
            i = i + 1
            firma = commit_campo(o, "author")
            if k == "c"
                firma = commit_campo(o, "committer")
            end
            r = r + _de_firma(firma, q)
        elif k == "x" and i + 1 < n
            v = str_to_int(f[i:i + 2], 16)
            i = i + 2
            if v > 0
                r = r + str_char(v)
            end
        else
            r = r + "%" + k
        end
    end
    return r
end

# Un trozo de una firma ("Nombre <correo> 1730720000 +0100"): n nombre, e correo, t segundos, d/i fecha, s día
func _de_firma(firma: String, q: String) -> String
    a = str_find(firma, " <")
    b = str_find(firma, ">")
    if q == "n"
        if a < 0
            return firma
        end
        return firma[:a]
    end
    if q == "e"
        if a < 0 or b < a
            return ""
        end
        return firma[a + 2:b]
    end
    if b < 0
        return ""
    end
    var p: [String] = str_split(str_trim(firma[b + 1:]), " ")
    if q == "t"
        if p.length < 1
            return ""
        end
        return p[0]
    end
    fecha = firma_fecha(firma)
    if q == "s"
        return fecha[:10]
    end
    return fecha
end

# Las opciones de formato de log y show: --oneline, --format=..., --pretty=...; true si a era una
var log_corto: Bool = false
var log_formato: String = ""
var log_con_formato: Bool = false

func opcion_formato(a: String) -> Bool
    if a == "--oneline"
        log_corto = true
    elif a == "--pretty=oneline"
        log_con_formato = true
        log_formato = "%H %s"
    elif a == "--pretty=short" or a == "--pretty=medium" or a == "--pretty"
        log_corto = false
        log_con_formato = false
    elif str_starts(a, "--format=")
        log_con_formato = true
        log_formato = a[9:]
    elif str_starts(a, "--pretty=format:")
        log_con_formato = true
        log_formato = a[16:]
    elif str_starts(a, "--pretty=tformat:")
        log_con_formato = true
        log_formato = a[17:]
    else
        return false
    end
    return true
end

# Escribe un commit como lo hace log (con las opciones de formato de arriba)
func escribir_commit(id: String, o: Objeto)
    if log_con_formato
        if log_formato != ""
            sal(a_latin1(formato_commit(log_formato, id, o)))
        end
        return
    end
    msg = a_latin1(commit_mensaje(o))
    if log_corto
        nl = str_find(msg, "\n")
        if nl >= 0
            msg = msg[:nl]
        end
        sal(id[:7] + " " + msg)
        return
    end
    sal("commit " + id)
    var ps0: [String] = commit_padres(o)
    if ps0.length > 1
        l = "Merge:"
        for pp in ps0
            l = l + " " + pp[:7]
        end
        sal(l)
    end
    autor = commit_campo(o, "author")
    sal("Autor: " + a_latin1(firma_quien(autor)))
    sal("Fecha: " + firma_fecha(autor))
    sal("")
    for l in str_split(str_trim(msg), "\n")
        sal("    " + l)
    end
    sal("")
end

# Los ids de esas rutas en un commit, juntos (para ver si un commit las cambia); con caché
func _ids_rutas(id: String, rutas: [String], cache: {String: String}) -> String
    hecho = cache.get(id, "?")
    if hecho != "?"
        return hecho
    end
    arbol = commit_arbol(id)
    r = ""
    for x in rutas
        r = r + id_en_arbol(arbol, x) + "|"
    end
    cache[id] = r
    return r
end

func orden_log(args: [String])
    log_corto = false
    log_con_formato = false
    max = -1
    desde = "HEAD"
    var rutas: [String] = []
    rutas_ya = false
    i = 0
    while i < args.length
        a = args[i]
        if rutas_ya
            rutas.push(ruta_git(a))
        elif a == "--"
            rutas_ya = true
        elif opcion_formato(a)
            # hecho
        elif a == "-n" and i + 1 < args.length
            max = Int(args[i + 1])
            i = i + 1
        elif str_starts(a, "--max-count=")
            max = str_to_int(a[12:], 10)
        elif str_starts(a, "-") and a.length > 1 and str_to_int(a[1:], 10) > 0
            max = str_to_int(a[1:], 10)
        elif rev_commit(a) == "" and a != "HEAD" and ruta_git(a) != "?"
            # como git: lo que no es un commit es una ruta
            rutas.push(ruta_git(a))
        else
            desde = a
        end
        i = i + 1
    end
    id = rev_commit(desde)
    if id == ""
        if desde == "HEAD"
            sal("Aún no hay commits")
        else
            aviso("no existe " + desde)
        end
        return
    end
    # todos los commits (de todos los padres), del más nuevo al más viejo por la fecha del committer, como git log:
    # se saca siempre el pendiente más nuevo (a igual fecha, el que entró antes). Con rutas, solo los que las
    # cambian; de una fusión que deja una igual que uno de sus padres, se sigue solo ese padre (como git)
    var cache: {String: String} = {}
    var pendientes: [String] = [id]
    var fechas: [Int] = [_fecha_commit(id)]
    var vistos_ids: {String: Int} = {}
    vistos_ids[id] = 1
    vistos = 0
    while pendientes.length > 0 and (max < 0 or vistos < max)
        k = 0
        q = 1
        while q < pendientes.length
            if fechas[q] > fechas[k]
                k = q
            end
            q = q + 1
        end
        id = pendientes[k]
        pendientes.remove(k)
        fechas.remove(k)
        o = objeto_leer(id)
        if o == nil
            aviso("falta el commit " + id)
            return
        end
        var ps: [String] = commit_padres(o)
        mostrar = true
        if rutas.length > 0
            mio = _ids_rutas(id, rutas, cache)
            if ps.length == 0
                vacio = ""
                for x in rutas
                    vacio = vacio + "|"
                end
                mostrar = mio != vacio
            else
                for pp in ps
                    if _ids_rutas(pp, rutas, cache) == mio
                        mostrar = false
                        var uno: [String] = [pp]
                        ps = uno
                        break
                    end
                end
            end
        end
        if mostrar
            escribir_commit(id, o)
            vistos = vistos + 1
        end
        objeto_libre(o)
        for pp in ps
            if vistos_ids.get(pp, 0) == 0
                vistos_ids[pp] = 1
                pendientes.push(pp)
                fechas.push(_fecha_commit(pp))
            end
        end
    end
end

# La fecha (segundos) del committer de un commit; 0 si no se puede leer
func _fecha_commit(id: String) -> Int
    o = objeto_leer(id)
    if o == nil
        return 0
    end
    f = commit_campo(o, "committer")
    objeto_libre(o)
    i = str_find(f, ">")
    if i < 0
        return 0
    end
    var p: [String] = str_split(str_trim(f[i + 1:]), " ")
    if p.length < 1
        return 0
    end
    return str_to_int(p[0], 10)
end

# ---- branch ----

func ramas() -> [String]
    var r: [String] = []
    _ramas_en("refs/heads", r)
    p = git_dir + "/packed-refs"
    if file_exists(p)
        for l in str_split(file_read_text(p), "\n")
            if l.length > 52 and es_id(l[:40]) and str_starts(l[41:], "refs/heads/")
                n = l[52:]
                esta = false
                for x in r
                    if x == n
                        esta = true
                    end
                end
                if not esta
                    r.push(n)
                end
            end
        end
    end
    r.sort(texto_antes)
    return r
end

func _ramas_en(rel: String, r: [String])
    n = dir_read(git_dir + "/" + rel)
    var cajones: [String] = []
    i = 0
    while i < n
        nombre = dir_entry_name(i)
        if dir_entry_is_dir(i)
            cajones.push(rel + "/" + nombre)
        elif not str_ends(nombre, ".lock") and not str_ends(nombre, ".uaem")
            r.push((rel + "/" + nombre)[11:])
        end
        i = i + 1
    end
    for c in cajones
        _ramas_en(c, r)
    end
end

func orden_branch(args: [String])
    if args.length == 1 and args[0] == "--show-current"
        # la rama actual (nada con HEAD suelto), como git
        rama = head_rama()
        if rama != ""
            sal(rama[11:])
        end
        return
    end
    if args.length == 0 or (args.length == 1 and (args[0] == "--list" or args[0] == "-l"))
        actual = head_rama()
        for b in ramas()
            if "refs/heads/" + b == actual
                sal("* " + b)
            else
                sal("  " + b)
            end
        end
        return
    end
    if args[0] == "-d" or args[0] == "-D"
        if args.length < 2
            aviso("uso: branch -d rama")
            return
        end
        n = args[1]
        if "refs/heads/" + n == head_rama()
            aviso("no se puede borrar la rama en la que estás: " + n)
            return
        end
        id = ref_leer("refs/heads/" + n)
        if id == ""
            aviso("no existe la rama " + n)
            return
        end
        if not ref_borrar("refs/heads/" + n)
            aviso("no se pudo borrar del todo la rama " + n)
            return
        end
        sal("Rama " + n + " borrada (era " + id[:7] + ")")
        return
    end
    n = args[0]
    desde = "HEAD"
    if args.length > 1
        desde = args[1]
    end
    if ref_leer("refs/heads/" + n) != ""
        aviso("ya existe la rama " + n)
        return
    end
    id = rev_commit(desde)
    if id == ""
        aviso("no hay commit en " + desde)
        return
    end
    ref_escribir("refs/heads/" + n, id)
end

# ---- checkout ----

# Pasa el árbol de trabajo y el índice de los ficheros de "antes" a los de "despues"; false si hay cambios que se
# perderían (no toca nada)
func cambiar_arbol(antes: [EntradaIndice], despues: [EntradaIndice]) -> Bool
    return cambiar_arbol_con(antes, despues, true)
end

# mirar: comprobar antes que no se pierden cambios (no hace falta en un clon recién hecho)
func cambiar_arbol_con(antes: [EntradaIndice], despues: [EntradaIndice], mirar: Bool) -> Bool
    var tocados: {String: Int} = {}
    # lo que hay ahora en el índice: lo que no cambia entre los dos árboles se queda como está (con lo que el
    # usuario tenga añadido o sin añadir), como hace git
    var actual: {String: Int} = {}
    var idx_actual: [EntradaIndice] = []
    if mirar
        e = estado(true)
        if e == nil
            return false
        end
        if e.conflictos.length > 0
            aviso("hay conflictos sin resolver (dashgit status)")
            return false
        end
        for l in e.preparados
            tocados[l[3:]] = 1
        end
        for l in e.sin_preparar
            tocados[l[3:]] = 1
        end
        idx_actual = indice_leer()
        i = 0
        while i < idx_actual.length
            actual[idx_actual[i].ruta] = i + 1
            i = i + 1
        end
    end
    var en_antes: {String: Int} = {}
    i = 0
    while i < antes.length
        en_antes[antes[i].ruta] = i + 1
        i = i + 1
    end
    var en_despues: {String: Int} = {}
    i = 0
    while i < despues.length
        en_despues[despues[i].ruta] = i + 1
        i = i + 1
    end
    # lo que no puede estar en este disco: se salta (sin pisar ni borrar nada) y se queda en el índice
    var fuera: {String: String} = fuera_del_disco(despues)
    var fuera_antes: {String: String} = fuera_del_disco(antes)
    # ¿se perdería algo?
    var mal: [String] = []
    for d in despues
        if fuera.get(d.ruta, "") != ""
            continue
        end
        p = en_antes.get(d.ruta, 0)
        if (p == 0 or antes[p - 1].id != d.id) and tocados.get(d.ruta, 0) == 1
            mal.push(d.ruta)
        end
        ruta = ruta_amiga(d.ruta)
        if p == 0 and tocados.get(d.ruta, 0) == 0 and file_exists(ruta)
            if dir_read(ruta) >= 0
                # un cajón donde irá un fichero: solo si es de antes y se va a vaciar
                if not _cajon_se_vacia(d.ruta, antes, en_despues)
                    mal.push(d.ruta + " (hay un cajón con ese nombre)")
                end
            elif trabajo_guardar(d.ruta, false) != d.id
                # un fichero sin seguimiento que se pisaría
                mal.push(d.ruta)
            end
        end
    end
    for a in antes
        if en_despues.get(a.ruta, 0) == 0 and tocados.get(a.ruta, 0) == 1
            mal.push(a.ruta)
        end
    end
    if mal.length > 0
        aviso("estos ficheros tienen cambios que se perderían:")
        for m in mal
            sal("        " + utf8_to_latin1(m))
        end
        sal("Haz commit de ellos o deshazlos antes de cambiar.")
        return false
    end
    # quitar lo que ya no está (antes de escribir: un fichero "a" puede dejar sitio a un cajón "a/")
    for a in antes
        if en_despues.get(a.ruta, 0) == 0 and fuera_antes.get(a.ruta, "") == ""
            file_delete(ruta_amiga(a.ruta))
            _quitar_cajones_vacios(ruta_padre(ruta_amiga(a.ruta)))
        end
    end
    # escribir lo nuevo o cambiado, y el índice
    var idx: [EntradaIndice] = []
    fallo = ""
    for d in despues
        p = en_antes.get(d.ruta, 0)
        cambia = p == 0 or antes[p - 1].id != d.id
        q = actual.get(d.ruta, 0)
        razon = fuera.get(d.ruta, "")
        if razon != ""
            sal("dashgit: se salta " + utf8_to_latin1(d.ruta) + ": " + razon)
            x = EntradaIndice()
            x.ruta = d.ruta
            x.id = d.id
            x.modo = d.modo
            idx.push(x)
        elif not cambia and mirar
            # igual en los dos commits: se queda lo que tenga el usuario (también si lo borró del disco)
            if q > 0
                idx.push(idx_actual[q - 1])
            end
        elif fallo == ""
            if not escribir_fichero(d)
                fallo = d.ruta
            else
                f = trabajo_mirar(d.ruta)
                x = EntradaIndice()
                x.ruta = d.ruta
                x.id = d.id
                x.modo = d.modo
                x.tam = f.tam
                x.mtime = f.mtime
                x.ctime = f.mtime
                idx.push(x)
            end
        end
    end
    # lo añadido que no está en ninguno de los dos commits (un fichero nuevo con add) se queda en el índice
    if mirar
        for x in idx_actual
            if x.etapa == 0 and en_antes.get(x.ruta, 0) == 0 and en_despues.get(x.ruta, 0) == 0
                idx.push(x)
            end
        end
    end
    if fallo != ""
        # el índice dice lo que de verdad quedó en el disco; lo que no se escribió sale como borrado
        indice_escribir(idx)
        aviso("no se pudo escribir " + utf8_to_latin1(fallo) + " (¿nombre que el disco no admite, disco lleno?); el cambio quedó a medias: dashgit status")
        return false
    end
    indice_escribir(idx)
    return true
end

# Si todo lo que hay en el cajón rel sale de antes y no está en despues (el cajón se quedará vacío)
func _cajon_se_vacia(rel: String, antes: [EntradaIndice], en_despues: {String: Int}) -> Bool
    hay = false
    for a in antes
        if str_starts(a.ruta, rel + "/")
            hay = true
            if en_despues.get(a.ruta, 0) != 0
                return false
            end
        end
    end
    return hay
end

func _quitar_cajones_vacios(d: String)
    c = d
    while str_lower(c) != str_lower(raiz) and c != ""
        if dir_read(c) != 0
            return
        end
        file_delete(c)
        c = ruta_padre(c)
    end
end

# Escribe un fichero del árbol de trabajo desde su blob
func escribir_fichero(e: EntradaIndice) -> Bool
    if e.modo == MODO_ENLACE or e.modo == MODO_SUBMODULO
        aviso("se salta " + utf8_to_latin1(e.ruta) + " (enlace o submódulo)")
        return true
    end
    o = objeto_leer(e.id)
    if o == nil
        return false
    end
    ruta = ruta_amiga(e.ruta)
    crear_cajones(ruta_padre(ruta))
    ok = file_save(ruta, o.datos, o.n) == o.n
    objeto_libre(o)
    return ok
end

func orden_checkout(args: [String])
    if args.length == 0
        aviso("uso: checkout rama | checkout -b rama nueva | checkout -- fichero")
        return
    end
    # checkout -- fichero: devolverlo como está en el índice
    if args[0] == "--"
        var idx: [EntradaIndice] = indice_leer()
        i = 1
        while i < args.length
            r = ruta_git(args[i])
            hallado = false
            for e in idx
                if dentro_de(e.ruta, r)
                    hallado = true
                    escribir_fichero(e)
                    f = trabajo_mirar(e.ruta)
                    e.tam = f.tam
                    e.mtime = f.mtime
                end
            end
            if not hallado
                aviso(args[i] + " no está en el índice")
            end
            i = i + 1
        end
        indice_escribir(idx)
        return
    end
    nueva = ""
    destino = args[0]
    if args[0] == "-b"
        if args.length < 2
            aviso("uso: checkout -b rama")
            return
        end
        nueva = args[1]
        if ref_leer("refs/heads/" + nueva) != ""
            aviso("ya existe la rama " + nueva)
            return
        end
        destino = "HEAD"
        if args.length > 2
            destino = args[2]
        end
    end
    id = resolver_commit(destino)
    if id == ""
        aviso("no existe " + destino)
        return
    end
    actual = head_id()
    if id != actual
        var antes: [EntradaIndice] = ficheros_de_commit(actual)
        var despues: [EntradaIndice] = ficheros_de_commit(id)
        if antes == nil or despues == nil
            aviso("falta algún objeto")
            return
        end
        if not cambiar_arbol(antes, despues)
            return
        end
    end
    if nueva != ""
        ref_escribir("refs/heads/" + nueva, id)
        file_write_text(git_dir + "/HEAD", "ref: refs/heads/" + nueva + "\n")
        sal("Cambiado a la rama nueva " + nueva)
    elif ref_leer("refs/heads/" + destino) != ""
        file_write_text(git_dir + "/HEAD", "ref: refs/heads/" + destino + "\n")
        sal("Cambiado a la rama " + destino)
    else
        file_write_text(git_dir + "/HEAD", id + "\n")
        sal("HEAD suelto en " + id[:7])
    end
end

# ---- reset y restore ----

# El tamaño de un objeto (para el índice); -1 si no se puede leer
func _tam_objeto(id: String) -> Int
    o = objeto_leer(id)
    if o == nil
        return -1
    end
    n = o.n
    objeto_libre(o)
    return n
end

# Una entrada del índice para lo que hay en un commit: si el índice ya tenía ese mismo contenido, con sus datos
# del disco; si no, con su tamaño y sin fecha (status lo vuelve a mirar)
func entrada_de_commit(c: EntradaIndice, viejo: [EntradaIndice]) -> EntradaIndice
    p = indice_buscar(viejo, c.ruta)
    if p >= 0 and viejo[p].id == c.id and viejo[p].etapa == 0
        x = viejo[p]
        x.modo = c.modo
        return x
    end
    e = EntradaIndice()
    e.ruta = c.ruta
    e.id = c.id
    e.modo = c.modo
    e.tam = _tam_objeto(c.id)
    return e
end

# reset [--soft | --mixed] [commit] [--] [ruta...]: con rutas, las devuelve en el índice a como están en el commit
# (HEAD si no se dice): quita del índice lo añadido sin tocar el disco. Sin rutas, todo el índice; con un commit,
# además lleva la rama allí (--soft: solo la rama).
func orden_reset(args: [String])
    blando = false
    desde = ""
    var filtro: [String] = []
    rutas_ya = false
    for a in args
        if rutas_ya
            filtro.push(ruta_git(a))
        elif a == "--"
            rutas_ya = true
        elif a == "--soft"
            blando = true
        elif a == "--mixed" or a == "-q" or a == "--quiet"
            # lo de siempre
        elif a == "--hard" or a == "--keep" or a == "--merge"
            aviso("reset " + a + " aún no está: usa dashgit checkout -- fichero para deshacer los cambios del disco")
            return
        elif desde == "" and filtro.length == 0 and rev_commit(a) != ""
            desde = a
        else
            filtro.push(ruta_git(a))
        end
    end
    for r in filtro
        if r == "?"
            aviso("una ruta está fuera del repositorio")
            return
        end
    end
    id = head_id()
    if desde != ""
        id = rev_commit(desde)
    end
    if desde != "" and filtro.length > 0 and blando
        aviso("reset --soft no admite rutas")
        return
    end
    var cab: [EntradaIndice] = ficheros_de_commit(id)
    if cab == nil
        aviso("falta algún objeto del commit " + id)
        return
    end
    var idx: [EntradaIndice] = indice_leer()
    if idx == nil
        aviso(indice_error)
        return
    end
    if filtro.length == 0
        if blando
            if desde == ""
                return
            end
        else
            var nuevo: [EntradaIndice] = []
            for c in cab
                nuevo.push(entrada_de_commit(c, idx))
            end
            if not indice_escribir(nuevo)
                aviso("no se pudo escribir el índice")
                return
            end
        end
        if desde != "" and id != head_id()
            rama = head_rama()
            if rama == ""
                file_write_text(git_dir + "/HEAD", id + "\n")
            else
                ref_escribir(rama, id)
            end
            file_delete(git_dir + "/MERGE_HEAD")
            file_delete(git_dir + "/MERGE_MSG")
        end
        return
    end
    # solo esas rutas: fuera del índice lo que hay de ellas, y dentro lo del commit
    var resultado: [EntradaIndice] = []
    for e in idx
        dentro = false
        for r in filtro
            if dentro_de(e.ruta, r)
                dentro = true
            end
        end
        if not dentro
            resultado.push(e)
        end
    end
    for c in cab
        for r in filtro
            if dentro_de(c.ruta, r)
                resultado.push(entrada_de_commit(c, idx))
                break
            end
        end
    end
    if not indice_escribir(resultado)
        aviso("no se pudo escribir el índice")
    end
end

# restore [--staged] [--] ruta...: --staged es reset de esas rutas; sin él, checkout -- ruta
func orden_restore(args: [String])
    preparado = false
    var resto: [String] = []
    for a in args
        if a == "--staged" or a == "-S"
            preparado = true
        elif a == "--worktree" or a == "-W"
            # lo de siempre
        elif a != "--"
            resto.push(a)
        end
    end
    if resto.length == 0
        aviso("uso: restore [--staged] fichero...")
        return
    end
    if preparado
        var r: [String] = ["--"]
        for x in resto
            r.push(x)
        end
        orden_reset(r)
    else
        var c: [String] = ["--"]
        for x in resto
            c.push(x)
        end
        orden_checkout(c)
    end
end
