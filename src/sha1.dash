# dashgit - SHA-1 en Dash puro (hasta que Dash tenga sha1 como builtin)
# Copyright (C) 2026 FreeMEM
# Licencia: GPLv2 (ver LICENSE)
#
# Uso:
#     s = sha1_nuevo()
#     sha1_poner(s, buffer, desde, n)    # tantas veces como haga falta
#     sha1_acabar(s, salida, desde)      # 20 bytes en salida + desde
#     sha1_libre(s)
# o de una vez: sha1d_hex(buffer, n) -> "da39a3ee..."

struct Sha1
    h0: Int = 0
    h1: Int = 0
    h2: Int = 0
    h3: Int = 0
    h4: Int = 0
    bloque: Pointer = nil   # 64 bytes por llenar
    w: Pointer = nil        # 80 longs
    lleno: Int = 0          # bytes en bloque
    total: Int = 0          # bytes vistos (hasta 512 MB: el largo en bits cabe en 32)
end

func _rotl(x: Int, n: Int) -> Int
    return (x << n) | ((x >> (32 - n)) & ((1 << n) - 1))
end

func sha1_nuevo() -> Sha1
    s = Sha1()
    s.h0 = 0x67452301
    s.h1 = 0xEFCDAB89
    s.h2 = 0x98BADCFE
    s.h3 = 0x10325476
    s.h4 = 0xC3D2E1F0
    s.bloque = buffer_alloc(64)
    s.w = buffer_alloc(320)
    return s
end

func sha1_libre(s: Sha1)
    if s.bloque != nil
        buffer_free(s.bloque)
        s.bloque = nil
    end
    if s.w != nil
        buffer_free(s.w)
        s.w = nil
    end
end

# Un bloque de 64 bytes de buf + desde
func _sha1_bloque(s: Sha1, buf: Pointer, desde: Int)
    w = s.w
    for i in (0..15)
        buffer_set_long(w, i * 4, buffer_get_long(buf, desde + i * 4))
    end
    for i in (16..79)
        x = buffer_get_long(w, (i - 3) * 4) ^ buffer_get_long(w, (i - 8) * 4) ^ buffer_get_long(w, (i - 14) * 4) ^ buffer_get_long(w, (i - 16) * 4)
        buffer_set_long(w, i * 4, _rotl(x, 1))
    end
    a = s.h0
    b = s.h1
    c = s.h2
    d = s.h3
    e = s.h4
    f = 0
    k = 0
    for i in (0..79)
        if i < 20
            f = (b & c) | ((~b) & d)
            k = 0x5A827999
        elif i < 40
            f = b ^ c ^ d
            k = 0x6ED9EBA1
        elif i < 60
            f = (b & c) | (b & d) | (c & d)
            k = 0x8F1BBCDC
        else
            f = b ^ c ^ d
            k = 0xCA62C1D6
        end
        t = _rotl(a, 5) + f + e + k + buffer_get_long(w, i * 4)
        e = d
        d = c
        c = _rotl(b, 30)
        b = a
        a = t
    end
    s.h0 = s.h0 + a
    s.h1 = s.h1 + b
    s.h2 = s.h2 + c
    s.h3 = s.h3 + d
    s.h4 = s.h4 + e
end

# Añade n bytes de buf + desde
func sha1_poner(s: Sha1, buf: Pointer, desde: Int, n: Int)
    s.total = s.total + n
    i = desde
    fin = desde + n
    # completar el bloque a medias
    if s.lleno > 0
        while s.lleno < 64 and i < fin
            buffer_set_byte(s.bloque, s.lleno, buffer_get_byte(buf, i))
            s.lleno = s.lleno + 1
            i = i + 1
        end
        if s.lleno == 64
            _sha1_bloque(s, s.bloque, 0)
            s.lleno = 0
        end
    end
    # bloques enteros, sin copiar
    while fin - i >= 64
        _sha1_bloque(s, buf, i)
        i = i + 64
    end
    # lo que sobra
    while i < fin
        buffer_set_byte(s.bloque, s.lleno, buffer_get_byte(buf, i))
        s.lleno = s.lleno + 1
        i = i + 1
    end
end

# Añade un texto
func sha1_poner_texto(s: Sha1, t: String)
    n = t.length
    if n == 0
        return
    end
    b = buffer_alloc(n)
    str_to_buffer(t, b, 0)
    sha1_poner(s, b, 0, n)
    buffer_free(b)
end

# Acaba y deja los 20 bytes en salida + desde
func sha1_acabar(s: Sha1, salida: Pointer, desde: Int)
    bits = s.total * 8
    altos = (s.total >> 29) & 7
    buffer_set_byte(s.bloque, s.lleno, 0x80)
    s.lleno = s.lleno + 1
    if s.lleno > 56
        buffer_fill(s.bloque, s.lleno, 64 - s.lleno, 0)
        _sha1_bloque(s, s.bloque, 0)
        s.lleno = 0
    end
    buffer_fill(s.bloque, s.lleno, 56 - s.lleno, 0)
    buffer_set_long(s.bloque, 56, altos)
    buffer_set_long(s.bloque, 60, bits)
    _sha1_bloque(s, s.bloque, 0)
    s.lleno = 0
    buffer_set_long(salida, desde, s.h0)
    buffer_set_long(salida, desde + 4, s.h1)
    buffer_set_long(salida, desde + 8, s.h2)
    buffer_set_long(salida, desde + 12, s.h3)
    buffer_set_long(salida, desde + 16, s.h4)
end

const _HEX = "0123456789abcdef"

# n bytes de buf + desde en hexadecimal
func hex_de(buf: Pointer, desde: Int, n: Int) -> String
    r = ""
    i = 0
    while i < n
        v = buffer_get_byte(buf, desde + i)
        r = r + _HEX[(v >> 4) & 15] + _HEX[v & 15]
        i = i + 1
    end
    return r
end

# El SHA-1 de n bytes de buf, en hexadecimal
func sha1d_hex(buf: Pointer, n: Int) -> String
    s = sha1_nuevo()
    sha1_poner(s, buf, 0, n)
    out = buffer_alloc(20)
    sha1_acabar(s, out, 0)
    sha1_libre(s)
    r = hex_de(out, 0, 20)
    buffer_free(out)
    return r
end
