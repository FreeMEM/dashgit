import "util.dash"
import "hash.dash"

# El cajón .git del repositorio (lo pone repo.dash)
var git_dir: String = ""

struct Objeto
    tipo: String = ""      # "blob", "tree", "commit" o "tag"
    datos: Pointer = nil
    n: Int = 0
end

func objeto_libre(o: Objeto)
    if o != nil and o.datos != nil
        buffer_free(o.datos)
        o.datos = nil
    end
end

# ---- zlib (cabecera 78 9C, deflate y adler32) ----

func zlib_comprimir(src: Pointer, n: Int) -> Trozo
    max = n + n / 50 + 128
    t = Trozo()
    t.buf = buffer_alloc(max + 6)
    buffer_set_byte(t.buf, 0, 0x78)
    buffer_set_byte(t.buf, 1, 0x9C)
    k = deflate(src, n, t.buf + 2, max, 6)
    if k < 0
        trozo_libre(t)
        return nil
    end
    buffer_set_long(t.buf, 2 + k, adler(src, n))
    t.n = k + 6
    return t
end

# Descomprime zlib (o deflate); tam: lo que se espera que ocupe (0 si no se sabe)
func zlib_descomprimir(src: Pointer, n: Int, tam: Int) -> Trozo
    max = tam
    if max <= 0
        max = n * 4 + 256
    end
    while true
        t = Trozo()
        t.buf = buffer_alloc(max + 1)
        r = inflate_auto(src, n, t.buf, max)
        if r >= 0
            t.n = r
            return t
        end
        trozo_libre(t)
        if r != -2
            return nil
        end
        max = max * 2
    end
    return nil
end

# ---- objetos sueltos ----

func ruta_objeto(id: String) -> String
    return git_dir + "/objects/" + id[:2] + "/" + id[2:]
end

# La cabecera y los datos de un objeto, juntos en un búfer ("blob 5\0hola\n")
func con_cabecera(tipo: String, datos: Pointer, n: Int) -> Trozo
    cab = tipo + " " + str_from_int(n, 10)
    h = cab.length + 1
    t = Trozo()
    t.n = h + n
    t.buf = buffer_alloc(t.n + 1)
    str_to_buffer(cab, t.buf, 0)
    buffer_set_byte(t.buf, cab.length, 0)
    if n > 0
        buffer_copy(t.buf, h, datos, 0, n)
    end
    return t
end

# El id de unos datos como objeto de ese tipo; con escribir, lo guarda (si no estaba). "" si no pudo guardarlo.
func objeto_escribir(tipo: String, datos: Pointer, n: Int, escribir: Bool) -> String
    t = con_cabecera(tipo, datos, n)
    id = hash_hex(t.buf, t.n)
    if escribir
        ruta = ruta_objeto(id)
        if not file_exists(ruta)
            crear_cajones(git_dir + "/objects/" + id[:2])
            z = zlib_comprimir(t.buf, t.n)
            if z == nil
                trozo_libre(t)
                return ""
            end
            tmp = ruta + ".tmp"
            ok = file_save(tmp, z.buf, z.n) == z.n
            trozo_libre(z)
            if not ok or not file_rename(tmp, ruta)
                file_delete(tmp)
                trozo_libre(t)
                return ""
            end
        end
    end
    trozo_libre(t)
    return id
end

func objeto_escribir_texto(tipo: String, s: String) -> String
    t = texto_a_trozo(s)
    id = objeto_escribir(tipo, t.buf, t.n, true)
    trozo_libre(t)
    return id
end

func objeto_existe(id: String) -> Bool
    if file_exists(ruta_objeto(id))
        return true
    end
    return pack_buscar(id) != nil
end

# Lee un objeto, suelto o de un pack; nil si no está o está roto
func objeto_leer(id: String) -> Objeto
    z = leer_fichero(ruta_objeto(id))
    if z == nil
        return pack_leer(id)
    end
    t = zlib_descomprimir(z.buf, z.n, 0)
    trozo_libre(z)
    if t == nil
        return nil
    end
    cero = buffer_find_byte(t.buf, 0, t.n, 0)
    if cero < 0
        trozo_libre(t)
        return nil
    end
    cab = str_from_buffer(t.buf, 0, cero)
    esp = str_find(cab, " ")
    if esp < 0
        trozo_libre(t)
        return nil
    end
    o = Objeto()
    o.tipo = cab[:esp]
    o.n = Int(cab[esp + 1:])
    if o.n != t.n - cero - 1
        trozo_libre(t)
        return nil
    end
    o.datos = buffer_alloc(o.n + 1)
    if o.n > 0
        buffer_copy(o.datos, 0, t.buf, cero + 1, o.n)
    end
    trozo_libre(t)
    return o
end

# ---- packs (.git/objects/pack/*.idx versión 2 y su .pack) ----

struct Pack
    ruta: String = ""      # el .pack
    idx: Pointer = nil     # el .idx entero
    n: Int = 0             # cuántos objetos
    tam: Int = 0           # bytes del .pack
    fh: Int = 0            # el .pack abierto (0 si no)
end

var packs_lista: [Pack] = []
# Mientras se indexa un pack recibido: id -> offset + 1 de sus objetos (para los deltas "ref")
var indexando_activo: Bool = false
var indexando: {String: Int} = {}
var packs_leidos: Bool = false

func cargar_packs()
    packs_leidos = true
    d = git_dir + "/objects/pack"
    n = dir_read(d)
    var nombres: [String] = []
    i = 0
    while i < n
        if str_ends(dir_entry_name(i), ".idx")
            nombres.push(dir_entry_name(i))
        end
        i = i + 1
    end
    for nombre in nombres
        t = leer_fichero(d + "/" + nombre)
        if t != nil and t.n > 1032 and buffer_get_long(t.buf, 0) == 0xFF744F63 and buffer_get_long(t.buf, 4) == 2
            p = Pack()
            p.idx = t.buf
            p.n = buffer_get_long(t.buf, 8 + 255 * 4)
            p.ruta = d + "/" + nombre[:nombre.length - 4] + ".pack"
            p.tam = file_size(p.ruta)
            if p.tam > 32
                packs_lista.push(p)
            else
                trozo_libre(t)
            end
        else
            trozo_libre(t)
        end
    end
end

# Compara los 20 bytes de a + ia con los de b + ib: <0, 0 o >0
func _cmp20(a: Pointer, ia: Int, b: Pointer, ib: Int) -> Int
    k = 0
    while k < 20
        x = buffer_get_byte(a, ia + k) - buffer_get_byte(b, ib + k)
        if x != 0
            return x
        end
        k = k + 1
    end
    return 0
end

# La posición de un id (20 bytes en bin) en un pack, o -1
func _pack_posicion(p: Pack, bin: Pointer) -> Int
    primero = buffer_get_byte(bin, 0)
    lo = 0
    if primero > 0
        lo = buffer_get_long(p.idx, 8 + (primero - 1) * 4)
    end
    hi = buffer_get_long(p.idx, 8 + primero * 4)
    while lo < hi
        m = (lo + hi) / 2
        c = _cmp20(p.idx, 1032 + m * 20, bin, 0)
        if c == 0
            return m
        end
        if c < 0
            lo = m + 1
        else
            hi = m
        end
    end
    return -1
end

# Dónde empieza en el .pack el objeto que está en la posición i del .idx
func _pack_offset(p: Pack, i: Int) -> Int
    tabla = 1032 + p.n * 24
    v = buffer_get_long(p.idx, tabla + i * 4)
    if v < 0
        grande = tabla + p.n * 4 + (v & 0x7FFFFFFF) * 8
        if buffer_get_long(p.idx, grande) != 0
            return -1
        end
        return buffer_get_long(p.idx, grande + 4)
    end
    return v
end

struct Hallado
    pack: Pack = nil
    offset: Int = 0
end

# En qué pack está un objeto, y dónde; nil si en ninguno
func pack_buscar(id: String) -> Hallado
    if not packs_leidos
        cargar_packs()
    end
    if packs_lista.length == 0
        return nil
    end
    bin = buffer_alloc(20)
    de_hex(id, bin, 0)
    for p in packs_lista
        i = _pack_posicion(p, bin)
        if i >= 0
            buffer_free(bin)
            h = Hallado()
            h.pack = p
            h.offset = _pack_offset(p, i)
            return h
        end
    end
    buffer_free(bin)
    return nil
end

func pack_leer(id: String) -> Objeto
    h = pack_buscar(id)
    if h == nil or h.offset < 0
        return nil
    end
    return pack_leer_en(h.pack, h.offset, 0)
end

const _TIPOS = ["", "commit", "tree", "blob", "tag"]

# El objeto que empieza en offset de un pack (con sus deltas resueltos)
func pack_leer_en(p: Pack, off: Int, prof: Int) -> Objeto
    if prof > 64
        return nil
    end
    if p.fh == 0
        p.fh = file_open(p.ruta, 1005)
        if p.fh == 0
            return nil
        end
    end
    cab = buffer_alloc(32)
    file_seek(p.fh, off, -1)
    file_read(p.fh, cab, 32)
    c = buffer_get_byte(cab, 0)
    tipo = (c >> 4) & 7
    tam = c & 15
    sh = 4
    k = 1
    while (c & 0x80) != 0
        c = buffer_get_byte(cab, k)
        tam = tam | ((c & 0x7F) << sh)
        sh = sh + 7
        k = k + 1
    end
    base_off = -1
    base_id = ""
    if tipo == 6
        c = buffer_get_byte(cab, k)
        k = k + 1
        v = c & 0x7F
        while (c & 0x80) != 0
            c = buffer_get_byte(cab, k)
            k = k + 1
            v = ((v + 1) << 7) | (c & 0x7F)
        end
        base_off = off - v
    elif tipo == 7
        base_id = a_hex(cab, k, 20)
        k = k + 20
    end
    buffer_free(cab)
    if tipo == 0 or tipo == 5
        return nil
    end
    # lo comprimido ocupa como mucho un poco más que lo descomprimido; no se pasa del final del pack
    ini = off + k
    max_in = tam + tam / 16 + 64
    resto = p.tam - 20 - ini
    if max_in > resto
        max_in = resto
    end
    z = buffer_alloc(max_in + 1)
    file_seek(p.fh, ini, -1)
    leidos = file_read(p.fh, z, max_in)
    datos = buffer_alloc(tam + 1)
    r = inflate_auto(z, leidos, datos, tam + 1)
    buffer_free(z)
    if r != tam
        buffer_free(datos)
        return nil
    end
    if tipo <= 4
        o = Objeto()
        o.tipo = _TIPOS[tipo]
        o.datos = datos
        o.n = tam
        return o
    end
    var base: Objeto = nil
    if tipo == 6
        base = pack_leer_en(p, base_off, prof + 1)
    elif indexando_activo and indexando.get(base_id, 0) > 0
        base = pack_leer_en(p, indexando.get(base_id, 0) - 1, prof + 1)
    else
        base = objeto_leer(base_id)
    end
    if base == nil
        buffer_free(datos)
        return nil
    end
    o = _delta_aplicar(base, datos, tam)
    objeto_libre(base)
    buffer_free(datos)
    return o
end

# Un número de tamaño de un delta (base 128, el byte bajo primero) desde d + pos[0]; avanza pos[0]
func _varint(d: Pointer, pos: [Int]) -> Int
    v = 0
    sh = 0
    c = 128
    while (c & 0x80) != 0
        c = buffer_get_byte(d, pos[0])
        pos[0] = pos[0] + 1
        v = v | ((c & 0x7F) << sh)
        sh = sh + 7
    end
    return v
end

# Aplica un delta de git a su base; nil si no encaja
func _delta_aplicar(base: Objeto, d: Pointer, n: Int) -> Objeto
    var pos: [Int] = [0]
    tam_base = _varint(d, pos)
    tam_fin = _varint(d, pos)
    if tam_base != base.n
        return nil
    end
    out = buffer_alloc(tam_fin + 1)
    o = 0
    i = pos[0]
    while i < n
        c = buffer_get_byte(d, i)
        i = i + 1
        if (c & 0x80) != 0
            desde = 0
            cuanto = 0
            if (c & 1) != 0
                desde = buffer_get_byte(d, i)
                i = i + 1
            end
            if (c & 2) != 0
                desde = desde | (buffer_get_byte(d, i) << 8)
                i = i + 1
            end
            if (c & 4) != 0
                desde = desde | (buffer_get_byte(d, i) << 16)
                i = i + 1
            end
            if (c & 8) != 0
                desde = desde | (buffer_get_byte(d, i) << 24)
                i = i + 1
            end
            if (c & 16) != 0
                cuanto = buffer_get_byte(d, i)
                i = i + 1
            end
            if (c & 32) != 0
                cuanto = cuanto | (buffer_get_byte(d, i) << 8)
                i = i + 1
            end
            if (c & 64) != 0
                cuanto = cuanto | (buffer_get_byte(d, i) << 16)
                i = i + 1
            end
            if cuanto == 0
                cuanto = 0x10000
            end
            if desde < 0 or desde + cuanto > base.n or o + cuanto > tam_fin
                buffer_free(out)
                return nil
            end
            buffer_copy(out, o, base.datos, desde, cuanto)
            o = o + cuanto
        elif c > 0
            if o + c > tam_fin or i + c > n
                buffer_free(out)
                return nil
            end
            buffer_copy(out, o, d, i, c)
            i = i + c
            o = o + c
        else
            buffer_free(out)
            return nil
        end
    end
    if o != tam_fin
        buffer_free(out)
        return nil
    end
    r = Objeto()
    r.tipo = base.tipo
    r.datos = out
    r.n = tam_fin
    return r
end

# ---- árboles ----

struct Entrada
    modo: String = ""     # "100644", "100755", "40000", "120000", "160000"
    nombre: String = ""   # en bytes de git (UTF-8)
    id: String = ""
end

func modo_tipo(modo: String) -> String
    if modo == "40000"
        return "tree"
    end
    if modo == "160000"
        return "commit"
    end
    return "blob"
end

# Las entradas de un árbol
func arbol_leer(o: Objeto) -> [Entrada]
    var r: [Entrada] = []
    i = 0
    while i < o.n
        esp = buffer_find_byte(o.datos, i, o.n, 32)
        cero = buffer_find_byte(o.datos, i, o.n, 0)
        if esp < 0 or cero < 0 or cero + 21 > o.n
            break
        end
        e = Entrada()
        e.modo = str_from_buffer(o.datos, i, esp - i)
        e.nombre = str_from_buffer(o.datos, esp + 1, cero - esp - 1)
        e.id = a_hex(o.datos, cero + 1, 20)
        r.push(e)
        i = cero + 21
    end
    return r
end

# La cabecera de un commit: el valor de un campo ("tree", "parent", "author"...), "" si no está
func commit_campo(o: Objeto, campo: String) -> String
    fin = o.n
    i = 0
    while i < fin
        nl = buffer_find_byte(o.datos, i, fin, 10)
        if nl < 0
            nl = fin
        end
        if nl == i
            return ""
        end
        linea = str_from_buffer(o.datos, i, nl - i)
        if str_starts(linea, campo + " ")
            return linea[campo.length + 1:]
        end
        i = nl + 1
    end
    return ""
end
