# dashgit - el índice (.git/index, versiones 2 y 3) y el árbol de trabajo
# Copyright (C) 2026 FreeMEM - GPLv2 (ver LICENSE)

import "repo.dash"

const MODO_FICHERO = 33188     # 0100644
const MODO_EJECUTABLE = 33261  # 0100755
const MODO_ENLACE = 40960      # 0120000
const MODO_SUBMODULO = 57344   # 0160000

struct EntradaIndice
    ruta: String = ""     # relativa a la raíz, con "/", en bytes de git (UTF-8)
    id: String = ""
    modo: Int = 33188
    tam: Int = 0
    ctime: Int = 0
    ctime_ns: Int = 0
    mtime: Int = 0
    mtime_ns: Int = 0
    dev: Int = 0
    ino: Int = 0
    uid: Int = 0
    gid: Int = 0
    etapa: Int = 0        # 0 normal; 1-3 en un conflicto de fusión
end

func modo_texto(m: Int) -> String
    if m == MODO_EJECUTABLE
        return "100755"
    end
    if m == MODO_ENLACE
        return "120000"
    end
    if m == MODO_SUBMODULO
        return "160000"
    end
    return "100644"
end

func modo_numero(s: String) -> Int
    if s == "100755"
        return MODO_EJECUTABLE
    end
    if s == "120000"
        return MODO_ENLACE
    end
    if s == "160000"
        return MODO_SUBMODULO
    end
    return MODO_FICHERO
end

func por_ruta(a: EntradaIndice, b: EntradaIndice) -> Int
    if a.ruta < b.ruta
        return -1
    end
    if a.ruta > b.ruta
        return 1
    end
    return a.etapa - b.etapa
end

var indice_error: String = ""

# Lee .git/index; una lista vacía si no hay. nil (con indice_error) si está mal.
func indice_leer() -> [EntradaIndice]
    var r: [EntradaIndice] = []
    ruta = git_dir + "/index"
    if not file_exists(ruta)
        return r
    end
    t = leer_fichero(ruta)
    if t == nil or t.n < 32
        indice_error = "no se puede leer " + ruta
        return nil
    end
    b = t.buf
    if not buffer_equals(b, 0, 4, "DIRC")
        indice_error = ruta + " no es un índice de git"
        trozo_libre(t)
        return nil
    end
    version = buffer_get_long(b, 4)
    if version != 2 and version != 3
        indice_error = "el índice es de la versión " + str_from_int(version, 10) + " (dashgit lee la 2 y la 3)"
        trozo_libre(t)
        return nil
    end
    cuantas = buffer_get_long(b, 8)
    o = 12
    k = 0
    while k < cuantas
        e = EntradaIndice()
        e.ctime = buffer_get_long(b, o)
        e.ctime_ns = buffer_get_long(b, o + 4)
        e.mtime = buffer_get_long(b, o + 8)
        e.mtime_ns = buffer_get_long(b, o + 12)
        e.dev = buffer_get_long(b, o + 16)
        e.ino = buffer_get_long(b, o + 20)
        e.modo = buffer_get_long(b, o + 24)
        e.uid = buffer_get_long(b, o + 28)
        e.gid = buffer_get_long(b, o + 32)
        e.tam = buffer_get_long(b, o + 36)
        e.id = a_hex(b, o + 40, 20)
        flags = buffer_get_word(b, o + 60)
        e.etapa = (flags >> 12) & 3
        nombre = o + 62
        if version == 3 and (flags & 0x4000) != 0
            nombre = nombre + 2
        end
        largo = flags & 0xFFF
        if largo == 0xFFF
            largo = buffer_find_byte(b, nombre, t.n, 0) - nombre
        end
        e.ruta = str_from_buffer(b, nombre, largo)
        r.push(e)
        # la entrada acaba con 1 a 8 bytes 0, hasta un múltiplo de 8 desde su principio
        o = o + (((nombre - o) + largo + 8) & 0xFFFFFFF8)
        k = k + 1
    end
    trozo_libre(t)
    return r
end

# Escribe .git/index (versión 2, sin extensiones)
func indice_escribir(l: [EntradaIndice]) -> Bool
    l.sort(por_ruta)
    # un fichero cambiado en este mismo segundo podría volver a cambiar sin que cambien su tamaño ni su fecha: esas
    # entradas van con fecha 0, para que la próxima vez se comparen por su contenido (lo que git llama "racy")
    ahora = time_unix()
    for e in l
        if e.mtime >= ahora - 1
            e.mtime = 0
            e.mtime_ns = 0
        end
    end
    total = 12 + 20
    for e in l
        total = total + ((62 + e.ruta.length + 8) & 0xFFFFFFF8)
    end
    b = buffer_alloc(total)
    buffer_fill(b, 0, total, 0)
    str_to_buffer("DIRC", b, 0)
    buffer_set_long(b, 4, 2)
    buffer_set_long(b, 8, l.length)
    o = 12
    for e in l
        buffer_set_long(b, o, e.ctime)
        buffer_set_long(b, o + 4, e.ctime_ns)
        buffer_set_long(b, o + 8, e.mtime)
        buffer_set_long(b, o + 12, e.mtime_ns)
        buffer_set_long(b, o + 16, e.dev)
        buffer_set_long(b, o + 20, e.ino)
        buffer_set_long(b, o + 24, e.modo)
        buffer_set_long(b, o + 28, e.uid)
        buffer_set_long(b, o + 32, e.gid)
        buffer_set_long(b, o + 36, e.tam)
        de_hex(e.id, b, o + 40)
        largo = e.ruta.length
        if largo > 0xFFF
            largo = 0xFFF
        end
        buffer_set_word(b, o + 60, (e.etapa << 12) | largo)
        str_to_buffer(e.ruta, b, o + 62)
        o = o + ((62 + e.ruta.length + 8) & 0xFFFFFFF8)
    end
    h = sha1_new()
    sha1_add(h, b, o)
    sha1_bytes(h, b + o)
    tmp = git_dir + "/index.lock"
    ok = file_save(tmp, b, total) == total
    buffer_free(b)
    if not ok
        file_delete(tmp)
        return false
    end
    file_delete(git_dir + "/index")
    return file_rename(tmp, git_dir + "/index")
end

# La posición de una ruta en el índice (etapa 0), o -1
func indice_buscar(l: [EntradaIndice], ruta: String) -> Int
    i = 0
    while i < l.length
        if l[i].ruta == ruta
            return i
        end
        i = i + 1
    end
    return -1
end

# ---- el árbol de trabajo ----

# Una ruta de git (UTF-8, con "/") a una ruta del Amiga bajo la raíz
func ruta_amiga(r: String) -> String
    return ruta_unir(raiz, utf8_to_latin1(r))
end

# ---- nombres que no se pueden sacar en este disco ----

var _max_nombre: Int = 0
var _max_probado: Bool = false     # se pudo escribir la prueba (si no, un disco protegido: no se sabe)

# El nombre más largo que admite el disco del repositorio: 30 (FFS, OFS) o más (se prueba una vez en .git)
func nombre_max() -> Int
    if _max_nombre == 0
        _max_nombre = 30
        prueba = "dashgit-prueba-de-nombres-largos.tmp"
        if file_write_text(git_dir + "/" + prueba, "x")
            _max_probado = true
            var borrar: [String] = []
            n = dir_read(git_dir)
            i = 0
            while i < n
                nombre = dir_entry_name(i)
                if nombre == prueba
                    _max_nombre = 107
                end
                if str_starts(nombre, "dashgit-prueba-de")
                    borrar.push(nombre)
                end
                i = i + 1
            end
            for b in borrar
                file_delete(git_dir + "/" + b)
            end
        end
    end
    return _max_nombre
end

# git guarda cada objeto en un fichero de 38 letras (.git/objects/xx/...) y cada pack en uno de 50: en un disco que
# no admite nombres tan largos (FFS u OFS sin nombres largos: 30 como mucho) no puede funcionar. Lo dice y da false
func disco_para_git() -> Bool
    if nombre_max() < 50 and _max_probado
        error("este disco solo admite nombres de hasta " + str_from_int(nombre_max(), 10) + " letras y git necesita 50 (los ficheros de .git/objects). Usa un disco PFS3, SFS o FFS con nombres largos (DOS7)")
        return false
    end
    return true
end

# Por qué una ruta de git no se puede escribir en el disco del Amiga; "" si se puede
func ruta_imposible(ruta: String) -> String
    l1 = utf8_to_latin1(ruta)
    if latin1_to_utf8(l1) != ruta
        return "tiene letras que no caben en Latin-1"
    end
    if str_contains(ruta, ":")
        return "tiene \":\", que el Amiga no admite en un nombre"
    end
    for parte in str_split(l1, "/")
        if parte.length > 30 and parte.length > nombre_max()
            return "un nombre de más de " + str_from_int(nombre_max(), 10) + " letras, que el disco no admite"
        end
    end
    return ""
end

# Las rutas de una lista que no pueden estar en el disco del Amiga, con el porqué: las de ruta_imposible, y las que
# solo se diferencian en mayúsculas de otra que va antes (el disco no distingue; se queda la primera), también si
# un cajón suyo choca así con un fichero
func fuera_del_disco(l: [EntradaIndice]) -> {String: String}
    var r: {String: String} = {}
    var bajas: {String: String} = {}
    for e in l
        razon = ruta_imposible(e.ruta)
        if razon != ""
            r[e.ruta] = razon
        else
            b = str_lower(utf8_to_latin1(e.ruta))
            otra = bajas.get(b, "")
            if otra != "" and otra != e.ruta
                r[e.ruta] = "solo cambia en mayúsculas de " + utf8_to_latin1(otra) + " (el disco no las distingue)"
            elif otra == ""
                bajas[b] = e.ruta
            end
        end
    end
    for e in l
        if r.get(e.ruta, "") == ""
            var partes: [String] = str_split(str_lower(utf8_to_latin1(e.ruta)), "/")
            pre = ""
            i = 0
            while i < partes.length - 1
                if pre != ""
                    pre = pre + "/"
                end
                pre = pre + partes[i]
                otra = bajas.get(pre, "")
                if otra != ""
                    r[e.ruta] = "su cajón choca con el fichero " + utf8_to_latin1(otra) + " (el disco no distingue mayúsculas)"
                end
                i = i + 1
            end
        end
    end
    return r
end

struct FicheroTrabajo
    ruta: String = ""     # de git (UTF-8, "/")
    tam: Int = 0
    mtime: Int = 0
end

func _por_ruta_trabajo(a: FicheroTrabajo, b: FicheroTrabajo) -> Bool
    return a.ruta < b.ruta
end

# Los ficheros bajo un cajón (relativo a la raíz: "" la raíz), sin .git, en orden de git
func trabajo_listar(rel: String) -> [FicheroTrabajo]
    var r: [FicheroTrabajo] = []
    _listar(rel, r)
    r.sort(_por_ruta_trabajo)
    return r
end

func _listar(rel: String, r: [FicheroTrabajo])
    d = raiz
    if rel != ""
        d = ruta_unir(raiz, utf8_to_latin1(rel))
    end
    n = dir_read(d)
    if n < 0
        return
    end
    # dir_read se pisa al bajar: copiar antes
    var cajones: [String] = []
    i = 0
    while i < n
        nombre = dir_entry_name(i)
        if true
            ruta = latin1_to_utf8(nombre)
            if rel != ""
                ruta = rel + "/" + ruta
            end
            if dir_entry_is_dir(i)
                if nombre != ".git"
                    cajones.push(ruta)
                end
            else
                f = FicheroTrabajo()
                f.ruta = ruta
                f.tam = dir_entry_size(i)
                f.mtime = dir_entry_date(i)
                r.push(f)
            end
        end
        i = i + 1
    end
    for c in cajones
        _listar(c, r)
    end
end

# El tamaño y la fecha de un fichero (por su cajón); tam -1 si no está
func trabajo_mirar(ruta: String) -> FicheroTrabajo
    f = FicheroTrabajo()
    f.ruta = ruta
    f.tam = -1
    amiga = ruta_amiga(ruta)
    d = ruta_padre(amiga)
    nombre = str_lower(ruta_nombre(amiga))
    n = dir_read(d)
    i = 0
    while i < n
        if str_lower(dir_entry_name(i)) == nombre and not dir_entry_is_dir(i)
            f.tam = dir_entry_size(i)
            f.mtime = dir_entry_date(i)
            return f
        end
        i = i + 1
    end
    return f
end

# Guarda un fichero del árbol de trabajo como blob: su id, o "" si no se pudo
func trabajo_guardar(ruta: String, escribir: Bool) -> String
    t = leer_fichero(ruta_amiga(ruta))
    if t == nil
        return ""
    end
    id = objeto_escribir("blob", t.buf, t.n, escribir)
    trozo_libre(t)
    return id
end

# ---- .gitignore, como git ----
# Las reglas de .git/info/exclude y de los .gitignore de cada cajón (los de un cajón valen para lo que tiene
# debajo, con rutas relativas a él). Gana la última regla que encaja del .gitignore más hondo; después el de su
# padre y así hasta la raíz; al final info/exclude. "!" vuelve a incluir, pero no lo que está en un cajón ignorado.
# "*" y "?" no saltan "/", "**" sí ("**/x", "x/**", "a/**/b"), [abc] [a-z] [!a]; "\" toma el carácter tal cual.
# Una regla con "/" al principio o en medio va contra la ruta desde su cajón; sin "/", contra el nombre.

struct Regla
    re: String = ""          # expresión regular; "" si se compara tal cual
    literal: String = ""     # el nombre tal cual (re == "") o lo que va tras "*" (sufijo)
    sufijo: Bool = false     # "*" + literal: basta con que el nombre acabe así
    niega: Bool = false
    solo_cajon: Bool = false
    anclado: Bool = false
end

var _reglas: [Regla] = []
var _fuente_desde: {String: Int} = {}    # "/cajón" (o "!exclude") -> primera regla
var _fuente_hasta: {String: Int} = {}    # -> la siguiente a la última
var _fuente_leida: {String: Int} = {}
var _cajon_ignorado: {String: Int} = {}  # 1 ignorado, 2 no: lo ya mirado
var _ignorar_leido: Bool = false
var _ign_mayus: Bool = false

func _es_alnum(c: Int) -> Bool
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c >= 128
end

# Un carácter tal cual en una expresión regular
func _re_literal(ch: String) -> String
    c = str_code(ch, 0)
    if _es_alnum(c) or c == 47
        return ch
    end
    return "\\" + ch
end

# Dónde acaba la clase [...] que empieza en i; -1 si no se cierra (entonces "[" es tal cual)
func _fin_clase(p: String, i: Int) -> Int
    n = p.length
    j = i + 1
    if j < n and (str_code(p, j) == 33 or str_code(p, j) == 94)
        j = j + 1
    end
    if j < n and str_code(p, j) == 93
        j = j + 1
    end
    while j < n and str_code(p, j) != 93
        if str_code(p, j) == 91 and j + 1 < n and str_code(p, j + 1) == 58
            k = str_find_from(p, ":]", j + 2)
            if k < 0
                return -1
            end
            j = k + 1
        elif str_code(p, j) == 92
            j = j + 1
        end
        j = j + 1
    end
    if j >= n
        return -1
    end
    return j
end

# Lo de dentro de [...] (sin los corchetes) a una clase de expresión regular
func _clase(c: String) -> String
    r = "["
    i = 0
    n = c.length
    if n > 0 and (str_code(c, 0) == 33 or str_code(c, 0) == 94)
        r = "[^/"
        i = 1
    end
    while i < n
        k = str_code(c, i)
        if k == 91 and i + 1 < n and str_code(c, i + 1) == 58
            f = str_find_from(c, ":]", i + 2)
            nombre = c[i + 2:f]
            if nombre == "alpha"
                r = r + "a-zA-Z"
            elif nombre == "digit"
                r = r + "0-9"
            elif nombre == "alnum"
                r = r + "a-zA-Z0-9"
            elif nombre == "upper"
                r = r + "A-Z"
            elif nombre == "lower"
                r = r + "a-z"
            elif nombre == "xdigit"
                r = r + "0-9a-fA-F"
            elif nombre == "space"
                r = r + " \\t\\n\\r"
            end
            i = f + 2
            continue
        end
        if k == 92 and i + 1 < n
            i = i + 1
            k = str_code(c, i)
        elif k == 45
            r = r + "-"
            i = i + 1
            continue
        end
        if _es_alnum(k)
            r = r + c[i:i + 1]
        else
            r = r + "\\" + c[i:i + 1]
        end
        i = i + 1
    end
    return r + "]"
end

# Un comodín de .gitignore a expresión regular
func _a_regex(p: String) -> String
    r = ""
    n = p.length
    i = 0
    while i < n
        c = str_code(p, i)
        if c == 42
            j = i
            while j < n and str_code(p, j) == 42
                j = j + 1
            end
            if j - i >= 2
                antes = i == 0 or str_code(p, i - 1) == 47
                if antes and j < n and str_code(p, j) == 47
                    # "**/" o "/**/": ningún cajón o varios
                    r = r + "(?:.*/)?"
                    i = j + 1
                    continue
                end
                if antes and j == n
                    r = r + ".*"
                    i = j
                    continue
                end
            end
            r = r + "[^/]*"
            i = j
            continue
        end
        if c == 63
            r = r + "[^/]"
        elif c == 91
            k = _fin_clase(p, i)
            if k < 0
                r = r + "\\["
            else
                r = r + _clase(p[i + 1:k])
                i = k
            end
        elif c == 92
            if i + 1 < n
                i = i + 1
                r = r + _re_literal(p[i:i + 1])
            end
        else
            r = r + _re_literal(p[i:i + 1])
        end
        i = i + 1
    end
    return r
end

func _con_comodines(p: String) -> Bool
    return str_contains(p, "*") or str_contains(p, "?") or str_contains(p, "[") or str_contains(p, "\\")
end

# Una línea de un .gitignore a regla; nil si no es regla
func _regla(linea: String) -> Regla
    l = linea
    if str_ends(l, "\r")
        l = l[:l.length - 1]
    end
    # los espacios del final no cuentan, salvo "\ "
    while str_ends(l, " ") and not str_ends(l, "\\ ")
        l = l[:l.length - 1]
    end
    if l == "" or str_starts(l, "#")
        return nil
    end
    r = Regla()
    if str_starts(l, "!")
        r.niega = true
        l = l[1:]
    end
    if str_ends(l, "/")
        r.solo_cajon = true
        l = l[:l.length - 1]
    end
    if l == ""
        return nil
    end
    r.anclado = str_contains(l, "/")
    if str_starts(l, "/")
        l = l[1:]
    end
    if not _con_comodines(l)
        r.literal = l
    elif not r.anclado and str_starts(l, "*") and not _con_comodines(l[1:])
        r.sufijo = true
        r.literal = l[1:]
    else
        r.re = _a_regex(l)
    end
    if _ign_mayus
        r.literal = str_lower(r.literal)
    end
    return r
end

# Lee las reglas de un fichero (si existe) como la fuente "clave"
func _leer_fuente(clave: String, fichero: String)
    _fuente_leida[clave] = 1
    _fuente_desde[clave] = _reglas.length
    if file_exists(fichero)
        t = file_read_text(fichero)
        if t != nil
            # git los guarda en UTF-8; uno escrito en el Amiga puede venir en Latin-1
            tr = texto_a_trozo(t)
            if tr.n > 0 and utf8_check(tr.buf, 0, tr.n) >= 0
                t = latin1_to_utf8(t)
            end
            trozo_libre(tr)
            for linea in str_split(t, "\n")
                r = _regla(linea)
                if r != nil
                    _reglas.push(r)
                end
            end
        end
    end
    _fuente_hasta[clave] = _reglas.length
end

func _leer_ignorar()
    _ignorar_leido = true
    _ign_mayus = str_lower(config_leer("core.ignorecase")) == "true"
    _leer_fuente("!exclude", git_dir + "/info/exclude")
end

func _encaja(r: Regla, rel: String, nombre: String, es_cajon: Bool) -> Bool
    if r.solo_cajon and not es_cajon
        return false
    end
    s = nombre
    if r.anclado
        s = rel
    end
    if r.re != ""
        return regex_match(r.re, s, _ign_mayus)
    end
    if _ign_mayus
        s = str_lower(s)
    end
    if r.sufijo
        return str_ends(s, r.literal)
    end
    return s == r.literal
end

# 1 si las reglas de una fuente ignoran la ruta, 2 si la vuelven a incluir, 0 si no dicen nada
func _fuente_decide(clave: String, rel: String, nombre: String, es_cajon: Bool) -> Int
    desde = _fuente_desde.get(clave, 0)
    j = _fuente_hasta.get(clave, 0) - 1
    while j >= desde
        r = _reglas[j]
        if _encaja(r, rel, nombre, es_cajon)
            if r.niega
                return 2
            end
            return 1
        end
        j = j - 1
    end
    return 0
end

# Si las reglas ignoran esta ruta de "cuantas" partes (sin mirar los cajones de encima)
func _ignorada_una(ruta: String, partes: [String], cuantas: Int, es_cajon: Bool) -> Bool
    nombre = partes[cuantas - 1]
    # los .gitignore de los cajones de encima, del más hondo a la raíz
    k = cuantas - 1
    while k >= 0
        base = ""
        q = 0
        while q < k
            if q > 0
                base = base + "/"
            end
            base = base + partes[q]
            q = q + 1
        end
        clave = "/" + base
        if _fuente_leida.get(clave, 0) == 0
            fichero = ruta_amiga(".gitignore")
            if base != ""
                fichero = ruta_amiga(base + "/.gitignore")
            end
            _leer_fuente(clave, fichero)
        end
        rel = ruta
        if base != ""
            rel = ruta[base.length + 1:]
        end
        d = _fuente_decide(clave, rel, nombre, es_cajon)
        if d != 0
            return d == 1
        end
        k = k - 1
    end
    return _fuente_decide("!exclude", ruta, nombre, es_cajon) == 1
end

# Si git ignora esta ruta (de git, de un fichero)
func ignorada(ruta: String) -> Bool
    if not _ignorar_leido
        _leer_ignorar()
    end
    var partes: [String] = str_split(ruta, "/")
    n = partes.length
    pre = ""
    c = 1
    while c <= n
        if pre != ""
            pre = pre + "/"
        end
        pre = pre + partes[c - 1]
        if c < n
            # un cajón ignorado ignora todo lo de dentro (no se puede volver a incluir)
            v = _cajon_ignorado.get(pre, 0)
            if v == 0
                v = 2
                if _ignorada_una(pre, partes, c, true)
                    v = 1
                end
                _cajon_ignorado[pre] = v
            end
            if v == 1
                return true
            end
        else
            return _ignorada_una(pre, partes, c, false)
        end
        c = c + 1
    end
    return false
end
